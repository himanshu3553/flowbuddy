// FlowBuddy data model (Phase 1a). Postgres via Prisma.
// Auth.js tables (User/Account/Session/VerificationToken) + app tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) core ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials provider (email + password)
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  ownedWorkspaces Workspace[]  @relation("WorkspaceOwner")
  recSessions     KnowledgeSource[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App ----------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // -> portal subdomain
  ownerId   String
  createdAt DateTime @default(now())

  // P1-M9 — embeddable copilot: a PUBLIC key (safe in client HTML, distinct from the secret
  // recorder ApiToken) + an origin allowlist (empty = allow any, for dev).
  copilotPublicKey      String?  @unique
  copilotAllowedOrigins String[] @default([])
  // Trust setting: show the "Source: <workflow>" citation chip on grounded answers (default on).
  copilotShowCitations  Boolean  @default(true)
  // Appearance (host branding) — flows into the embed snippet's data-flowbuddy-* attrs (null = widget default).
  copilotAccent         String?
  copilotTitle          String?
  copilotGreeting       String?
  copilotPosition       String   @default("right")
  copilotLauncherStyle  String   @default("icon") // icon | text | text-outline
  copilotLauncherText   String?
  // Embed detection: the widget pings a heartbeat on mount, so the Studio can show real "live /
  // detected" status (vs. inferring it from query traffic). Null = never seen the snippet load.
  widgetLastSeenAt      DateTime?
  widgetLastSeenOrigin  String?
  // P2 Sense (in-context help) — the per-workspace master toggle. Gates the sense-plan endpoint:
  // off = the widget never probes and the copilot answers exactly as before (route bias only).
  senseEnabled          Boolean  @default(true)
  // P2-M3 "show me" — when on, the widget also HIGHLIGHTS the current step's element on the host
  // page alongside a positional answer (off = text-only). Served to the widget via /v1/copilot/config.
  //
  // Default flipped to ON for new workspaces 2026-07-27, together with the Copilot-mode default
  // below it. These two switches were off because in AI Chatbot mode they fire on a FIXED RULE —
  // every positional answer highlights, every positional answer offers a walkthrough — which is
  // noisy enough that a founder should opt in. In Copilot mode there is no rule: the assistant
  // decides per message whether pointing actually helps (widget `wantsOnPage`). So the switch stops
  // meaning "do this every time" and starts meaning "you MAY do this when it helps" — and left off,
  // the default Copilot is one the picker describes as pointing and guiding while being unable to.
  // The switch still wins in both modes: nothing here can turn an ability on that the founder
  // turned off. Existing workspaces are untouched (a column default applies only to new rows).
  copilotShowMe         Boolean  @default(true)
  // P4-M0 guided walkthrough — when on, positional answers offer "Walk me through it": the widget
  // highlights each remaining step and follows the user's progress (the user does everything;
  // FlowBuddy never acts). Needs Sense (on by default). Served to the widget via /v1/copilot/config.
  // On by default since 2026-07-27 — same reasoning as `copilotShowMe` above. Still zero-acting.
  copilotWalkthrough    Boolean  @default(true)
  // P2-M5 Reason (diagnostic reasoning) — the founder toggle ladder (docs/build/sense-and-reason.md §B5):
  // `reasonEnabled` gates the whole diagnostic path (ask-time structured page-state capture, values
  // masked). `reasonImageEnabled` adds the DOM-rendered page image (the most sensitive capture;
  // for its default and why, see the field below). `reasonIncludeValues`
  // unmasks typed field values in the capture (hard floors apply regardless: passwords are never
  // captured, card/SSN patterns always masked). All served to the widget via /v1/copilot/config.
  // The copilot's OPERATING MODE — how much the assistant is allowed to decide for itself, and
  // (later) the pricing tier. Founder-selected, strictly ordered, one per workspace:
  //   "chatbot" → shown as **AI Chatbot** — one grounded answer per question, fixed rules decide
  //               the rest. The SAFETY FLOOR: where an unrecognised value lands, and the runtime
  //               fallback underneath the others when the agent loop errors or times out.
  //   "copilot" → shown as **Copilot** — the agent loop: it chooses which grounded primitive to
  //               use, turn by turn (explain · point · guide · diagnose). Still READ-ONLY: it
  //               never clicks, types, or navigates. **The default for new workspaces since
  //               2026-07-27** — the product's opinion about what FlowBuddy is. Note the default
  //               below and the floor above are now DIFFERENT values, and deliberately so: the
  //               default may climb the ladder as modes prove out, the floor may only descend.
  //   "agent"   → shown as **AI Agent** — adds acting. NOT BUILT; never a default.
  // Deliberately a STRING, not an enum: mode 3 (and anything after it) slots in by adding a value
  // rather than altering the database. The stored key is internal — the founder-facing labels above
  // live in the UI layer, so renaming a tier is a text change with no migration (user decision
  // 2026-07-26). Unknown values are treated as "chatbot" by the server: fail closed, never open.
  // Nothing sets this on create (see web/lib/workspace.ts), so THIS default is the only lever;
  // mirrored for readers in shared/copilot-mode.ts `NEW_WORKSPACE_MODE` — change both together.
  // GOTCHA: Prisma Client bakes scalar defaults in at `prisma generate` time and sends them
  // explicitly, so it — not the column default — is what a create actually applies. Editing the
  // default here without regenerating changes nothing (`pnpm build` regenerates; the migration
  // keeps the column in step for anything that writes SQL directly).
  copilotMode           String   @default("copilot")
  reasonEnabled         Boolean  @default(true)
  // Image tier default ON since 2026-07-16 (visual-only state — met/unmet checklists, banners — is
  // where diagnosis quality lives); the founder still owns the toggle + the disclosure snippet.
  reasonImageEnabled    Boolean  @default(true)
  reasonIncludeValues   Boolean  @default(false)

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  tokens           ApiToken[]
  sessions         KnowledgeSource[]
  coverageGaps     CoverageGap[]
  copilotApprovals CopilotApproval[]
  copilotQueries   CopilotQuery[]
  walkthroughs     CopilotWalkthrough[]
  overlapDismissals WorkflowOverlapDismissal[]
  workflows        Workflow[]
}

model ApiToken {
  id          String   @id @default(cuid())
  workspaceId String
  hashedToken String   @unique
  label       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  // The per-recording source record (architecture: "KnowledgeSource"). Module 1 output.
  // Table kept as "RecSession" via @@map so existing data is preserved.
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  // The RECORDER's own id for this recording, minted once when Record is pressed and stable across
  // every retry. It is what makes ingestion idempotent: a re-sent recording resolves to this row
  // instead of creating a second one. Nullable only so pre-existing rows stay valid; every new
  // recording has it. Deliberately NOT the primary key — the composite unique below scopes it per
  // workspace, so a client-supplied value can never collide with another workspace's recording.
  uploadId    String?
  kind        String   @default("workflow") // workflow | narration | video
  // recording = artifacts are still arriving (the row exists from the first signed upload, so a
  // recording is visible in Studio while it uploads rather than only after it finishes).
  status      String   @default("uploaded") // recording | uploaded | processing | ready | done | error  (ready = KB built + segmented, candidates available, no articles yet)
  title       String? // founder-given label for the recording (null = fall back to appBaseUrl)
  appBaseUrl  String?
  manifest    Json? // raw capture manifest (events, markers, meta) — null until the recording is stopped and finalized
  transcript  Json? // persisted narration transcript { text, segments[] } — for retrieval
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt // last touch (status flips included) — drives the "stalled processing" surface

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdById], references: [id])
  items            KnowledgeItem[]
  workflows        Workflow[]

  @@unique([workspaceId, uploadId])
  @@map("RecSession")
}

model Workflow {
  // P3-M1 — a workflow's DURABLE identity, independent of the recording slot that currently carries it.
  //
  // Before this, "a workflow" WAS `(sourceId, segmentIndex)` — a position. That was safe only while
  // re-segmentation was deterministic: the same recording always split the same way, so position 2
  // was always the same workflow. It no longer is (reasoning models cannot express temperature 0),
  // so a position is no longer an identity, and an approval that follows a position can land on
  // content nobody reviewed. This row is the identity; the position is a mutable fact ABOUT it.
  //
  // `sourceId`/`segmentIndex` are therefore DELIBERATELY MUTABLE: a reprocess re-matches distilled
  // workflows to these rows BY CONTENT and updates the position on the winner. Never treat them as
  // the identity again — that is the bug this table exists to end.
  //
  // `segmentIndex` is NULL when the workflow is DETACHED: a reprocess re-split the recording and
  // nothing in it matched this workflow any more, so it has no position because it is no longer
  // there. The row survives regardless — its approval, its analytics history and the founder's
  // ability to understand what happened all depend on it — and that approval is moved to
  // `needs_review` rather than deleted. (Postgres allows many NULLs under a unique index, so any
  // number of workflows can sit detached from one recording.)
  id           String   @id @default(cuid())
  workspaceId  String
  sourceId     String
  segmentIndex Int?
  // The workflow's name, kept here so it survives the worker's delete-and-recreate of its items.
  // (`KnowledgeItem.segmentTitle` still carries a per-item copy for now; this is the future home.)
  title        String?
  // The workflow's PLAN in prose — what the task achieves, what is optional, what has to happen
  // first. Written at KB build from the founder's narration plus the finished steps.
  //
  // The steps say what to CLICK; this says what you are DOING and why. It must never restate a
  // click target: no overlap is what makes it impossible for the two to contradict each other, and
  // it is the only rule this field needs. Structured step data cannot express a plan — a recording
  // is a list of actions, and "you only need one of these" exists solely in what the founder said.
  //
  // ⚠️ This is MODEL OUTPUT entering approved knowledge, unlike steps, which are anchored to real
  // captured events. Studio must show it wherever a founder approves a workflow — otherwise approval
  // stops covering everything the copilot may say.
  description  String?
  // P3-M1 variant grouping — workflows the founder confirmed are two ROUTES to one goal share a
  // `taskId`. `null` = its own task, which is the overwhelmingly common case. A plain shared string
  // rather than a table: grouping is a set, needs no attributes of its own, and stays transitive
  // (group C with B and C simply takes B's taskId).
  taskId       String?
  createdAt    DateTime @default(now())

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source    KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items     KnowledgeItem[]
  approval  CopilotApproval?

  @@unique([sourceId, segmentIndex])
  @@index([workspaceId])
  @@index([taskId])
}

model KnowledgeItem {
  // Module 2: the normalized, indexed unit of knowledge. One per step (workflow) or topic (narration).
  id          String   @id @default(cuid())
  sourceId    String
  workspaceId String
  // P3-M1 — the durable workflow this step belongs to. REQUIRED: a step that belongs to no workflow
  // is not a thing that can exist, and the worker mints the identity before writing the step.
  // (`segmentIndex`/`segmentTitle` below are the OLD position-based key, still read by retrieval and
  // five other consumers — they are dropped in stage 3 when those move over. They are not kept.)
  workflowId  String
  kind         String // step | topic
  orderIndex   Int
  text         String // searchable content — keyword scoring AND the embedding input (already folds in narration via distilledStepText)
  data         Json // step: { instruction, detail, route, narration, screenshotFile, bbox } (distilled — 2026-06-27; legacy pre-distillation rows: { event, narration }) ; topic: { spanText, startMs, endMs }
  segmentIndex Int? // workflow this item belongs to (Path 2 — persisted segmentation, promoted toward Option C)
  segmentTitle String?
  // P1-M3 hybrid retrieval — text-embedding-3-small(1536) over `text`, written by the worker at KB
  // build via raw SQL (Prisma can't write Unsupported). Nullable: rows without a vector (embed-call
  // failure, pre-upgrade data) stay retrievable through keyword scoring.
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())

  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workflow Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@index([workflowId])
}

model CoverageGap {
  // Module 3.2: a prompt-to-article request the KB could NOT cover → "record this next".
  id          String   @id @default(cuid())
  workspaceId String
  prompt      String // the requested topic / the end-user question
  reason      String? // why the AI declined (grounding gap)
  status      String   @default("open") // open | resolved
  source      String   @default("prompt") // prompt (Text->Article) | copilot (P1-M10)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CopilotApproval {
  // P1-M5: the copilot trust gate. One row = one workflow approved for the copilot to answer from.
  // Keyed by (sourceId, segmentIndex) so approval SURVIVES KnowledgeItem delete+recreate on reprocess
  // (the worker deletes+recreates items, which would wipe a per-item flag). Absence = not approved.
  // P3-M1: an approval names a WORKFLOW and nothing else. It used to carry `(sourceId,
  // segmentIndex)` as its key — a position — which is exactly how a re-split walked an approval onto
  // content nobody had reviewed. The recording and position now live on the `Workflow` row, where
  // they are mutable facts about it; keeping a second copy here would be an invitation to key on
  // them again.
  id           String   @id @default(cuid())
  workspaceId  String
  segmentTitle String? // snapshot of the title at approval time (display/audit)
  approvedById String? // who approved (audit)
  createdAt    DateTime @default(now())
  // ── Is this approval LIVE? ───────────────────────────────────────────────────────────────────
  // **`inactiveReason IS NULL` is THE one test, everywhere.** An approval is never deleted — the
  // recording, the analytics history and the undo all depend on the row surviving — so "not
  // answering" is a state, and this is the only column that expresses it. Six independent readers
  // filter on it; a SECOND way to be inactive would mean six places to forget, so anything new that
  // takes a workflow out of service becomes another value here, never another column.
  //   "superseded"   — P3-M0: the founder re-recorded the task and said the new telling replaces
  //                    this one. `supersededById` names the approval that replaced it.
  //   "needs_review" — P3-M1: a reprocess could not confirm that the content at this workflow is
  //                    still what was approved. Fail-closed: it stops answering until a human looks.
  // Deliberately a STRING, not an enum — a new reason ships without a database migration, and an
  // unrecognised value still reads as "not live", which is the safe direction.
  inactiveReason String?
  inactiveAt     DateTime?
  // Set only when `inactiveReason = "superseded"`. `onDelete: SetNull` is deliberate: un-approving
  // the replacement must not leave the workspace with neither approved (a silent coverage hole).
  supersededById String?
  // P3-M1 — the durable workflow this approval is FOR. REQUIRED: approving nothing is not a state.
  // Once stage 3 moves readers over, this (not the `sourceId`/`segmentIndex` above) is what
  // "approved" means, and a reprocess can no longer walk an approval onto content nobody reviewed.
  // Those two columns are dropped in stage 3 — they are the old key, not a second one worth keeping.
  workflowId     String    @unique

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  supersededBy CopilotApproval?  @relation("Supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   CopilotApproval[] @relation("Supersedes")

  @@index([workspaceId])
  @@index([supersededById])
  @@index([inactiveReason])
}

model WorkflowOverlapDismissal {
  // P3-M1 — "these are NOT duplicates." Detection compares workflows by content and can be wrong:
  // two unrelated tasks that share their opening navigation once scored 0.757 against each other.
  // When the founder says the detector is wrong, that has to be remembered or the pair is raised at
  // every visit.
  //
  // ⚠️ This is NOT the same decision as "two routes to one goal" — that one groups the workflows
  // under a shared `Workflow.taskId` and makes the copilot ANSWER FROM ONLY ONE of them. Recording a
  // false positive as a grouping would silence half a workspace's knowledge. The two outcomes look
  // alike in the UI and must never be collapsed into one action.
  //
  // The pair is stored in CANONICAL order (lexicographically smaller workflow id first) so it can
  // never be recorded twice under two orderings.
  id           String   @id @default(cuid())
  workspaceId  String
  aWorkflowId  String
  bWorkflowId  String
  decidedById  String?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([aWorkflowId, bWorkflowId])
  @@index([workspaceId])
}

model CopilotQuery {
  // P1-M10: a logged end-user question to the copilot (feedback loop + analytics).
  id          String   @id @default(cuid())
  workspaceId String
  question    String
  answered    Boolean // true = covered/answered, false = declined
  feedback    String? // up | down | null (thumbs from the widget)
  contextPath String? // P1-M8: host-app path the end-user was on when they asked (e.g. "/settings")
  // P2 Sense — the localization outcome attached to this question (P2-M4 step-friction analytics).
  // A row where the probe localized the user records WHERE ("workflow W, step k") and whether the
  // answer actually USED that position. `senseUsed`: used | ignored (hypotheses sent, answer was
  // about something else — must NOT count as step friction) | none (probe ran, nothing matched —
  // a passive drift signal). Null = pre-Sense row / no probe ran.
  senseSourceId     String?
  senseSegmentIndex Int?
  senseStep         Int? // 1-based step index within the workflow
  senseConfidence   Float?
  senseUsed         String?
  // P2-M5 Reason — why the diagnostic path fired for this question: intent (diagnostic wording) |
  // blocked (the current step's target was disabled) | escalation (the fast path declined and the
  // widget retried with evidence). Null = the fast path answered. `reasonImage` = whether the
  // user's rendered page image rode along on the diagnostic call.
  // What the ANSWER PATH did for this question (2026-07-29). Until these existed the founder could
  // see that a question was declined but nothing about how — a decline after three fruitless
  // searches and a decline with no attempt at all looked identical, and switching a workspace to
  // Copilot mode produced no visible evidence it behaved any differently.
  //
  // `engine` is the one that matters, and it is NOT the same as the workspace's configured mode:
  // the diagnostic path preempts the agent whenever the widget shipped page state, and the safety
  // floor answers as AI Chatbot while the mode still reads "copilot". Recording the mode alone
  // would attribute both to the wrong engine. Both are stored so the gap between them is visible.
  //   mode   — the workspace setting at ask time: chatbot | copilot | agent
  //   engine — what actually produced this answer: chatbot | agent | reason
  //   rounds — model calls made (1 = answered straight from retrieval, no tool use)
  //   toolCalls — tool invocations the model asked for, INCLUDING ones the loop refused
  // Deliberately strings, not enums, and all nullable: pre-2026-07-29 rows keep meaning "unknown"
  // rather than being back-filled with a guess, and a fourth mode slots in without a migration.
  mode        String?
  engine      String?
  rounds      Int?
  toolCalls   Int?
  reasonTrigger     String?
  reasonImage       Boolean?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  citations QueryCitation[]

  @@index([workspaceId])
}

model CopilotWalkthrough {
  // P4-M0: one row per guided-walkthrough RUN (a session, not a query — the optional queryId keeps
  // the join to the question that offered it). Written by POST /v1/copilot/walkthrough: `started`
  // creates the row (workflow key verified against CopilotApproval first — no-leak), progress
  // events bump lastStep + the auto/manual counters, terminal events set the outcome. A row still
  // `active` past the widget's 30-min session TTL reads as abandoned (no sweeper by design).
  id             String   @id @default(cuid())
  workspaceId    String
  sourceId       String // KnowledgeSource the workflow belongs to
  segmentIndex   Int // the workflow within that source
  segmentTitle   String? // snapshot at start (display/audit, approval-sourced — never the wire)
  queryId        String? // originating CopilotQuery, when known
  startStep      Int // where the user entered (mid-workflow entry via Sense)
  totalSteps     Int
  lastStep       Int // furthest step reached
  autoAdvances   Int      @default(0) // steps detected automatically (measures detection quality for P4-M2)
  manualAdvances Int      @default(0) // steps advanced via the Next button
  outcome        String   @default("active") // active | completed | aborted | stalled
  stalledAtStep  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model QueryCitation {
  // Analytics: one row per workflow the copilot CITED to answer a question. Powers
  // "Top workflows by citations" (group by sourceId+segmentIndex). Cascades from the
  // parent CopilotQuery (which cascades from Workspace), so workspace delete cleans up.
  //
  // "One row per WORKFLOW" is enforced by the writer (api `citationRows`, 2026-07-27) — before that
  // the answer's per-STEP citation list was persisted one-to-one, so a workflow appeared once per
  // cited step and every reader that counted rows over-counted it. Rows written before that date
  // still hold those duplicates: they are left in place, and the readers in web/lib/analytics.ts
  // count DISTINCT queryId so old and new rows produce the same (correct) numbers. If you add a
  // reader, count distinct questions — do not count rows.
  id           String   @id @default(cuid())
  queryId      String
  workspaceId  String // denormalized for direct per-workspace aggregation (cf. KnowledgeItem)
  // P3-M1 — the durable workflow that was cited. Grouping on this instead of a position is what
  // keeps a workflow's citation history intact when a reprocess moves it.
  // NO foreign key, deliberately: this is a HISTORICAL LOG. It records what happened, and it must
  // survive the workflow being deleted — a cascade here would quietly erase the analytics history
  // of everything a founder ever removed.
  workflowId   String
  sourceId     String // KnowledgeSource the cited workflow belonged to (display / legacy grouping)
  segmentIndex Int? // its position at answer time (KnowledgeItem.segmentIndex)
  segmentTitle String? // snapshot of the workflow title at answer time (display)
  createdAt    DateTime @default(now())

  query CopilotQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([queryId])
  @@index([workflowId])
}
