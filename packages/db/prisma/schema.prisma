// FlowBuddy data model (Phase 1a). Postgres via Prisma.
// Auth.js tables (User/Account/Session/VerificationToken) + app tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth.js (NextAuth) core ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // credentials provider (email + password)
  createdAt     DateTime  @default(now())

  accounts        Account[]
  sessions        Session[]
  ownedWorkspaces Workspace[]  @relation("WorkspaceOwner")
  recSessions     KnowledgeSource[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App ----------

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // -> portal subdomain
  ownerId   String
  createdAt DateTime @default(now())

  // P1-M9 — embeddable copilot: a PUBLIC key (safe in client HTML, distinct from the secret
  // recorder ApiToken) + an origin allowlist (empty = allow any, for dev).
  copilotPublicKey      String?  @unique
  copilotAllowedOrigins String[] @default([])
  // Trust setting: show the "Source: <workflow>" citation chip on grounded answers (default on).
  copilotShowCitations  Boolean  @default(true)
  // Appearance (host branding) — flows into the embed snippet's data-flowbuddy-* attrs (null = widget default).
  copilotAccent         String?
  copilotTitle          String?
  copilotGreeting       String?
  copilotPosition       String   @default("right")
  copilotLauncherStyle  String   @default("icon") // icon | text | text-outline
  copilotLauncherText   String?
  // Embed detection: the widget pings a heartbeat on mount, so the Studio can show real "live /
  // detected" status (vs. inferring it from query traffic). Null = never seen the snippet load.
  widgetLastSeenAt      DateTime?
  widgetLastSeenOrigin  String?
  // P2 Sense (in-context help) — the per-workspace master toggle. Gates the sense-plan endpoint:
  // off = the widget never probes and the copilot answers exactly as before (route bias only).
  senseEnabled          Boolean  @default(true)
  // P2-M3 "show me" — when on, the widget also HIGHLIGHTS the current step's element on the host
  // page alongside a positional answer (off = text-only). Served to the widget via /v1/copilot/config.
  //
  // Default flipped to ON 2026-07-27, together with the Copilot-mode default below it.
  //
  // **This switch is the ONLY decider (2026-08-02).** ON means every positional answer highlights;
  // OFF means none do. There is no third behaviour. It briefly meant "you MAY do this when it
  // helps" — the assistant judging per message — and that reading was reversed by founder decision
  // (agent.md D8, amended): a switch that might or might not do anything is a control a founder
  // cannot demo, support, or tell apart from an OFF switch, and the judgment replacing it had never
  // been measured. The assistant's preference is still recorded on the answer, unobeyed, so the
  // question stays answerable from real traffic.
  //
  // These switches defaulted OFF in the era when a fixed rule last governed them, on the grounds
  // that firing every time is noisy enough to deserve opt-in. Both facts are true at once now, and
  // that is deliberate: the noise is bounded by structure (only POSITIONAL answers reach the rule,
  // a clarifying question sets no position, the highlight needs a resolved element, and the offer
  // needs remaining steps), and left off, the default Copilot is one the picker describes as
  // pointing and guiding while being unable to. Existing workspaces are untouched (a column default
  // applies only to new rows).
  copilotShowMe         Boolean  @default(true)
  // P4-M0 guided walkthrough — when on, positional answers offer "Walk me through it": the widget
  // highlights each remaining step and follows the user's progress (the user does everything;
  // FlowBuddy never acts). Needs Sense (on by default). Served to the widget via /v1/copilot/config.
  // On by default since 2026-07-27 — same reasoning as `copilotShowMe` above. Still zero-acting.
  copilotWalkthrough    Boolean  @default(true)
  // P2-M5 Reason (diagnostic reasoning) — the founder toggle ladder (docs/build/sense-and-reason.md §B5):
  // `reasonEnabled` gates the whole diagnostic path (ask-time structured page-state capture, values
  // masked). `reasonImageEnabled` adds the DOM-rendered page image (the most sensitive capture;
  // for its default and why, see the field below). `reasonIncludeValues`
  // unmasks typed field values in the capture (hard floors apply regardless: passwords are never
  // captured, card/SSN patterns always masked). All served to the widget via /v1/copilot/config.
  // The copilot's OPERATING MODE — whether the assistant may ACT, and (later) the pricing tier.
  // Founder-selected, strictly ordered, one per workspace. TWO legal values:
  //   "copilot" → shown as **Copilot** — the agent loop: it chooses which grounded primitive to
  //               use, turn by turn (explain · point · guide · diagnose). READ-ONLY: it never
  //               clicks, types, or navigates. The default for new workspaces, AND the safety
  //               floor where an unrecognised value lands.
  //   "agent"   → shown as **AI Agent** — adds acting. NOT BUILT; never a default, never a floor.
  //
  // A third value, "chatbot" (one grounded answer, fixed rules for the rest), was RETIRED — it was
  // a strictly worse Copilot carrying a second prompt and a second knowledge renderer that had to
  // be tuned in parallel forever. Migration 20260802180000 moves any surviving row to "copilot",
  // and a row that escapes it still reads forward correctly: the server's `parseCopilotMode` does
  // not recognise the value and fails closed to "copilot", which is exactly where it belongs.
  // (The ENGINE lives on as the floor beneath a failed agent loop, but it is not a mode and has no
  // stored value — see CopilotQuery.engine below.)
  //
  // The default and the floor now read IDENTICALLY and are still two separate constants in
  // shared/copilot-mode.ts. That is not redundancy: the day the default climbs to "agent", the
  // floor must not follow, or every typo and every rolled-back row becomes an acting agent.
  //
  // Deliberately a STRING, not an enum: a further mode slots in by adding a value rather than
  // altering the database — and retiring one costs an UPDATE rather than a type change, which is
  // what made this retirement a one-line migration. The stored key is internal — the founder-facing
  // labels live in the UI layer, so renaming a tier is a text change with no migration (user
  // decision 2026-07-26).
  // Nothing sets this on create (see web/lib/workspace.ts), so THIS default is the only lever;
  // mirrored for readers in shared/copilot-mode.ts `NEW_WORKSPACE_MODE` — change both together.
  // GOTCHA: Prisma Client bakes scalar defaults in at `prisma generate` time and sends them
  // explicitly, so it — not the column default — is what a create actually applies. Editing the
  // default here without regenerating changes nothing (`pnpm build` regenerates; the migration
  // keeps the column in step for anything that writes SQL directly).
  copilotMode           String   @default("copilot")
  reasonEnabled         Boolean  @default(true)
  // Image tier default ON since 2026-07-16 (visual-only state — met/unmet checklists, banners — is
  // where diagnosis quality lives); the founder still owns the toggle + the disclosure snippet.
  reasonImageEnabled    Boolean  @default(true)
  reasonIncludeValues   Boolean  @default(false)
  // Demo videos (roadmap §13) — the Studio-side feature flag. OFF hides the workflow page's
  // "Demo video" card and refuses the generate action; it gates nothing end-user-facing (the
  // feature never serves end users). Default OFF while the feature proves itself.
  demoVideosEnabled     Boolean  @default(false)

  owner            User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  tokens           ApiToken[]
  sessions         KnowledgeSource[]
  coverageGaps     CoverageGap[]
  copilotApprovals CopilotApproval[]
  copilotQueries   CopilotQuery[]
  walkthroughs     CopilotWalkthrough[]
  overlapDismissals WorkflowOverlapDismissal[]
  workflows        Workflow[]
  productPages     ProductPage[]
  executionPlans   ExecutionPlan[]
  executionRuns    ExecutionRun[]
  agentAcceptances AgentAcceptance[]
  demoVideos       DemoVideo[]
}

model ApiToken {
  id          String   @id @default(cuid())
  workspaceId String
  hashedToken String   @unique
  label       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model KnowledgeSource {
  // The per-recording source record (architecture: "KnowledgeSource"). Module 1 output.
  // Table kept as "RecSession" via @@map so existing data is preserved.
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  // The RECORDER's own id for this recording, minted once when Record is pressed and stable across
  // every retry. It is what makes ingestion idempotent: a re-sent recording resolves to this row
  // instead of creating a second one. Nullable only so pre-existing rows stay valid; every new
  // recording has it. Deliberately NOT the primary key — the composite unique below scopes it per
  // workspace, so a client-supplied value can never collide with another workspace's recording.
  uploadId    String?
  kind        String   @default("workflow") // workflow | narration | video
  // recording = artifacts are still arriving (the row exists from the first signed upload, so a
  // recording is visible in Studio while it uploads rather than only after it finishes).
  status      String   @default("uploaded") // recording | uploaded | processing | ready | done | error  (ready = KB built + segmented, candidates available, no articles yet)
  title       String? // founder-given label for the recording (null = fall back to appBaseUrl)
  appBaseUrl  String?
  manifest    Json? // raw capture manifest (events, markers, meta) — null until the recording is stopped and finalized
  transcript  Json? // persisted narration transcript { text, segments[] } — for retrieval
  // What this recording COVERS, written from the narration after distillation — the recording-level
  // sibling of Workflow.description (docs/build/application-intelligence.md, slice 1). Shown to the
  // founder in Studio; never served to end-users. Best-effort: null when there was no narration,
  // when it added nothing beyond the workflow titles, or when the call failed.
  description String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt // last touch (status flips included) — drives the "stalled processing" surface

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy        User              @relation(fields: [createdById], references: [id])
  items            KnowledgeItem[]
  workflows        Workflow[]

  @@unique([workspaceId, uploadId])
  @@map("RecSession")
}

model Workflow {
  // P3-M1 — a workflow's DURABLE identity, independent of the recording slot that currently carries it.
  //
  // Before this, "a workflow" WAS `(sourceId, segmentIndex)` — a position. That was safe only while
  // re-segmentation was deterministic: the same recording always split the same way, so position 2
  // was always the same workflow. It no longer is (reasoning models cannot express temperature 0),
  // so a position is no longer an identity, and an approval that follows a position can land on
  // content nobody reviewed. This row is the identity; the position is a mutable fact ABOUT it.
  //
  // `sourceId`/`segmentIndex` are therefore DELIBERATELY MUTABLE: a reprocess re-matches distilled
  // workflows to these rows BY CONTENT and updates the position on the winner. Never treat them as
  // the identity again — that is the bug this table exists to end.
  //
  // `segmentIndex` is NULL when the workflow is DETACHED: a reprocess re-split the recording and
  // nothing in it matched this workflow any more, so it has no position because it is no longer
  // there. The row survives regardless — its approval, its analytics history and the founder's
  // ability to understand what happened all depend on it — and that approval is moved to
  // `needs_review` rather than deleted. (Postgres allows many NULLs under a unique index, so any
  // number of workflows can sit detached from one recording.)
  id           String   @id @default(cuid())
  workspaceId  String
  sourceId     String
  segmentIndex Int?
  // The workflow's name, kept here so it survives the worker's delete-and-recreate of its items.
  // (`KnowledgeItem.segmentTitle` still carries a per-item copy for now; this is the future home.)
  title        String?
  // The workflow's PLAN in prose — what the task achieves, what is optional, what has to happen
  // first. Written at KB build from the founder's narration plus the finished steps.
  //
  // The steps say what to CLICK; this says what you are DOING and why. It must never restate a
  // click target: no overlap is what makes it impossible for the two to contradict each other, and
  // it is the only rule this field needs. Structured step data cannot express a plan — a recording
  // is a list of actions, and "you only need one of these" exists solely in what the founder said.
  //
  // ⚠️ This is MODEL OUTPUT entering approved knowledge, unlike steps, which are anchored to real
  // captured events. Studio must show it wherever a founder approves a workflow — otherwise approval
  // stops covering everything the copilot may say.
  description  String?
  // P3-M1 variant grouping — workflows the founder confirmed are two ROUTES to one goal share a
  // `taskId`. `null` = its own task, which is the overwhelmingly common case. A plain shared string
  // rather than a table: grouping is a set, needs no attributes of its own, and stays transitive
  // (group C with B and C simply takes B's taskId).
  taskId       String?
  // Founder edits (Studio) — a set timestamp means the field is HUMAN-OWNED: the reprocess worker
  // must keep the stored value instead of overwriting it with fresh model output. Null = model-owned,
  // refreshed on every rebuild. Clearing a description in Studio also stamps it — deliberate absence
  // is still the founder's word.
  titleEditedAt       DateTime?
  descriptionEditedAt DateTime?
  createdAt    DateTime @default(now())

  workspace     Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source        KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  items         KnowledgeItem[]
  approval      CopilotApproval?
  executionPlan ExecutionPlan?
  demoVideo     DemoVideo?

  @@unique([sourceId, segmentIndex])
  @@index([workspaceId])
  @@index([taskId])
}

// A workflow's generated DEMO VIDEO — the polished, branded MP4 the render worker derives from the
// workflow's distilled steps + stored frames + a TTS voiceover. One current video per workflow;
// regenerating overwrites the row and the object. Founder-facing only (Studio generates, watches,
// downloads) — nothing here is served to end users, so this deliberately does NOT read
// CopilotApproval and is not one of its liveness readers.
//
// `status` vocabulary (stored strings, so this comment owns them, same rule as the mode vocabulary):
//   queued      — render requested, job enqueued (or enqueue failed and a retry will re-request)
//   processing  — the worker is rendering
//   ready       — `fileKey` points at the finished MP4 under the recording's session prefix
//                 (workspaces/<ws>/sessions/<sourceId>/video/…), so deleting the recording
//                 deletes the video with it
//   error       — the final attempt failed; `error` says why. Matches KnowledgeSource's value —
//                 a string, not an enum, so a new state ships without a migration.
model DemoVideo {
  id          String   @id @default(cuid())
  workspaceId String
  workflowId  String   @unique
  status      String   @default("queued")
  fileKey     String?
  durationMs  Int?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model KnowledgeItem {
  // Module 2: the normalized, indexed unit of knowledge. One per step (workflow) or topic (narration).
  id          String   @id @default(cuid())
  sourceId    String
  workspaceId String
  // P3-M1 — the durable workflow this step belongs to. REQUIRED: a step that belongs to no workflow
  // is not a thing that can exist, and the worker mints the identity before writing the step.
  // (`segmentIndex`/`segmentTitle` below are the OLD position-based key, still read by retrieval and
  // five other consumers — they are dropped in stage 3 when those move over. They are not kept.)
  workflowId  String
  kind         String // step | topic
  orderIndex   Int
  text         String // searchable content — keyword scoring AND the embedding input (already folds in narration via distilledStepText)
  data         Json // step: { instruction, detail, route, narration, screenshotFile, bbox } (distilled — 2026-06-27; legacy pre-distillation rows: { event, narration }) ; topic: { spanText, startMs, endMs }
  segmentIndex Int? // workflow this item belongs to (Path 2 — persisted segmentation, promoted toward Option C)
  segmentTitle String?
  // Founder edit stamp — set when Studio rewrote this step's instruction/detail (edits update `text`,
  // `data` AND the vector together; a text write without its re-embed silently desyncs retrieval).
  // The worker carries the edit through a reprocess by re-attaching it to the new step with the same
  // `data.keyEventId`; an edit whose anchor no longer keys a step is LOST, surfaced in the
  // recording's notice.
  editedAt   DateTime?
  editedById String?
  // P1-M3 hybrid retrieval — text-embedding-3-small(1536) over `text`, written by the worker at KB
  // build via raw SQL (Prisma can't write Unsupported). Nullable: rows without a vector (embed-call
  // failure, pre-upgrade data) stay retrievable through keyword scoring.
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime @default(now())

  source   KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  workflow Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([sourceId])
  @@index([workflowId])
}

model ProductPage {
  // AIL slice 2 (docs/build/application-intelligence.md) — one derived KNOWLEDGE PAGE: what a thing
  // IS and how it relates, extracted from recorded narration. The knowledge-layer sibling of
  // `Workflow`: a durable identity whose content regenerates, re-matched BY CONTENT on reprocess.
  //
  // Trust boundary (AI-5): this is model prose, born UNAPPROVED. Serving requires
  // `approvedAt IS NOT NULL AND inactiveReason IS NULL` — the CopilotApproval liveness discipline,
  // page-sized. Retrieval is the ONE live-only reader today (synthesis/retrieval.ts); Studio's
  // review list deliberately reads all pages. Any NEW reader must choose one of those on purpose.
  //
  // An approved page's content NEVER changes silently: a re-derivation that no longer agrees parks
  // in `pending*` until the founder accepts or dismisses it. Pages are also never retired by an
  // extraction that simply didn't mention them — narration silence is not evidence of wrongness;
  // only the founder retires a page.
  id          String   @id @default(cuid())
  workspaceId String
  type        String // overview | concept  (area arrives with slice 3 — a new VALUE, not a new column)
  title       String
  // The page body: plain prose. It says what things ARE — it must never restate steps or click
  // targets (AI-2; enforced by the extraction prompt + founder review, the same contract as
  // Workflow.description one level down).
  content     String
  // AI-7 provenance — [{ sourceId, quote }]: which recording's narration this derives from, with
  // verbatim anchor quotes. The pages' analog of steps citing captured events: extraction DROPS any
  // page whose quotes don't appear in the transcript, so approval always covers grounded prose.
  provenance  Json
  // Slice 3 (AI-4: links are the graph) — [{ kind: 'workflow', workflowId, title }]: the tasks a
  // reader of this page most likely wants next. STRUCTURAL, not prose: refreshed on every sync and
  // deliberately NOT routed through the pending flow — safe because answers only ever surface the
  // keys of LIVE approved workflows (filtered in retrieval) and `get_workflow` re-checks approval
  // server-side, so a stale or wrong link can never open unapproved content. Page↔page links are
  // deferred until a consumer needs them.
  links       Json?
  // A newer derivation whose content no longer agrees with the approved text (open Q2's
  // propose-an-update-for-review). `pendingEmbedding` rides along so accepting the update keeps the
  // stored vector in step with the stored content — matching would otherwise loop this page through
  // pending forever (the stored vector would lag one derivation behind).
  pendingContent    String?
  pendingProvenance Json?
  pendingAt         DateTime?
  pendingEmbedding  Unsupported("vector(1536)")?
  // ── liveness: served iff approvedAt != null AND inactiveReason == null ──
  approvedAt     DateTime?
  approvedById   String?
  inactiveReason String? // "retired" — the founder switched it off. A new way to stop serving is a new VALUE.
  inactiveAt     DateTime?
  // Embedding over title+content (same model as KnowledgeItem) — decides identity on re-extraction
  // (AI-6) and serves the vector half of retrieval. Nullable: a page without a vector still serves
  // through keyword scoring and re-matches by title.
  embedding Unsupported("vector(1536)")?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CoverageGap {
  // Module 3.2: a prompt-to-article request the KB could NOT cover → "record this next".
  id          String   @id @default(cuid())
  workspaceId String
  prompt      String // the requested topic / the end-user question
  reason      String? // why the AI declined (grounding gap)
  status      String   @default("open") // open | resolved
  source      String   @default("prompt") // prompt (Text->Article) | copilot (P1-M10)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model CopilotApproval {
  // P1-M5: the copilot trust gate. One row = one workflow approved for the copilot to answer from.
  // Keyed by (sourceId, segmentIndex) so approval SURVIVES KnowledgeItem delete+recreate on reprocess
  // (the worker deletes+recreates items, which would wipe a per-item flag). Absence = not approved.
  // P3-M1: an approval names a WORKFLOW and nothing else. It used to carry `(sourceId,
  // segmentIndex)` as its key — a position — which is exactly how a re-split walked an approval onto
  // content nobody had reviewed. The recording and position now live on the `Workflow` row, where
  // they are mutable facts about it; keeping a second copy here would be an invitation to key on
  // them again.
  id           String   @id @default(cuid())
  workspaceId  String
  segmentTitle String? // snapshot of the title at approval time (display/audit)
  approvedById String? // who approved (audit)
  createdAt    DateTime @default(now())
  // ── Is this approval LIVE? ───────────────────────────────────────────────────────────────────
  // **`inactiveReason IS NULL` is THE one test, everywhere.** An approval is never deleted — the
  // recording, the analytics history and the undo all depend on the row surviving — so "not
  // answering" is a state, and this is the only column that expresses it. Many independent readers
  // filter on it — the acting ones ask a second question on top (`executeState`, below). They are
  // enumerated, never counted, in docs/internals/knowledge-base.md §6; a count here would go stale
  // and would also hide the readers it does not cover.
  // A SECOND way to be INACTIVE would mean a place to forget in every one of them, so anything new
  // that takes a workflow out of service becomes another value here, never another column.
  //   "superseded"   — P3-M0: the founder re-recorded the task and said the new telling replaces
  //                    this one. `supersededById` names the approval that replaced it.
  //   "needs_review" — P3-M1: a reprocess could not confirm that the content at this workflow is
  //                    still what was approved. Fail-closed: it stops answering until a human looks.
  // Deliberately a STRING, not an enum — a new reason ships without a database migration, and an
  // unrecognised value still reads as "not live", which is the safe direction.
  inactiveReason String?
  inactiveAt     DateTime?
  // Set only when `inactiveReason = "superseded"`. `onDelete: SetNull` is deliberate: un-approving
  // the replacement must not leave the workspace with neither approved (a silent coverage hole).
  supersededById String?
  // ── P4-M1: may the AGENT run this workflow for end-users? ───────────────────────────────────
  // The acting flag RIDES the approval row (agent.md §A2.8): acting presupposes approval, and
  // living here means liveness comes with it — every acting reader filters `inactiveReason: null`
  // AND `executeState: "enabled"`, so retiring a workflow stops it acting through the same single
  // column that stops it answering. Note this is a SECOND question, not a second liveness flag:
  // `inactiveReason` says whether the workflow may ANSWER; this says whether it may also be RUN.
  //   null           — never enabled (the overwhelmingly common state). Absence = never runnable.
  //   "enabled"      — the founder enabled acting; a compiled `ExecutionPlan` row exists (the
  //                    enable action refuses to set this without one).
  //   "needs_review" — a reprocess changed the steps and the new content is no longer eligible to
  //                    run (or the workflow lost its content). Fails closed until a human looks.
  // A STRING for the same reason `inactiveReason` is: a new way to be not-runnable is a new VALUE,
  // and an unrecognised value reads as "not runnable" — the safe direction.
  executeState       String?
  executeEnabledAt   DateTime?
  executeEnabledById String?
  // P3-M1 — the durable workflow this approval is FOR. REQUIRED: approving nothing is not a state.
  // Once stage 3 moves readers over, this (not the `sourceId`/`segmentIndex` above) is what
  // "approved" means, and a reprocess can no longer walk an approval onto content nobody reviewed.
  // Those two columns are dropped in stage 3 — they are the old key, not a second one worth keeping.
  workflowId     String    @unique

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  supersededBy CopilotApproval?  @relation("Supersedes", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes   CopilotApproval[] @relation("Supersedes")

  @@index([workspaceId])
  @@index([supersededById])
  @@index([inactiveReason])
}

model ExecutionPlan {
  // P4-M1 — the compiled, replay-ready artifact for ONE actable workflow (agent.md §A2.2): ordered
  // steps { verb, instruction, route, locators, postRoute?, inputSlot?, destructive?, expect? },
  // compiled from the recording's manifest when the founder ENABLES acting, and re-verified on
  // reprocess.
  //
  // `contract` (P3-M2, execution-contracts.md) is the workflow-level half: entry (route · screen
  // fingerprint · cold-start verdict) + outcome (destination route · final screen · final
  // markers). Per-step `expect` and the contract both derive from the KB's stored step EVIDENCE
  // (extracted at processing time — one layer, three consumers); rows processed before the
  // evidence layer fall back to the legacy enable-time last+destructive marker diff, and a null
  // `contract` means exactly "compiled before contracts existed" — the run then verifies as it
  // always did (absence never loosens).
  //
  // `planHash` is the CONSENT PIN: a run stores the hash it was consented against, so "the run
  // executed the plan the user agreed to" is checkable equality. It is derived from the steps
  // PLUS the contract (key-sorted), never from timestamps — the verification a user consented to
  // is pinned with the actions (EC-2).
  //
  // Lifecycle: created/replaced by the Studio enable action; refreshed by the worker when a
  // reprocess re-matches the workflow BY CONTENT and the new steps are still eligible; left in
  // place (stale, inert) when the approval's `executeState` blocks acting. Readers key on the
  // approval's `executeState`, NEVER on this row's existence — an orphaned plan (un-approve wipes
  // the approval row and its flag with it) is dead data, not a capability.
  id          String   @id @default(cuid())
  workspaceId String
  workflowId  String   @unique
  planHash    String
  stepCount   Int
  steps       Json
  contract    Json?
  createdAt   DateTime @default(now())
  compiledAt  DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflow  Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AgentAcceptance {
  // P4-M3 (slice 5) — the CONTRACTUAL record behind AI Agent mode (agent.md §7 Q4: acceptance is
  // a ROW, never a toggle state): who accepted which terms version, when. Written in the same
  // transaction that first sets `copilotMode` to `agent`; NEVER updated or deleted — switching
  // back to Copilot leaves the record (the mode is the switch, this is the history), and a new
  // terms version simply requires a new row. The Studio asks for acceptance only when no row
  // exists for the CURRENT `AGENT_TERMS_VERSION` (shared/copilot-mode.ts owns the version).
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  termsVersion String
  acceptedAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, termsVersion])
}

model ExecutionRun {
  // P4-M2 slice 4 — the acting run's AUDIT row (agent.md §A2.8): the consent moment, the plan pin,
  // per-step outcomes with their input SOURCES (never values), and the final state. Created at run
  // start — which IS the consent click — after the server re-verified mode, liveness, the acting
  // flag and the plan hash live; per-step and terminal events are appended by the widget as the
  // run proceeds, clamped and untrusted like the walkthrough's analytics. "Did this user authorize
  // this run, and what did it do?" is answered from this row, never from model output (D8).
  //
  // `workflowId` carries NO relation on purpose (the QueryCitation precedent): an audit row must
  // survive the workflow, the recording, and any reprocess. `segmentTitle` is the display snapshot
  // for the same reason. A row still `active` past the widget's run TTL reads as abandoned — no
  // sweeper, same posture as CopilotWalkthrough.
  id             String   @id @default(cuid())
  workspaceId    String
  workflowId     String
  segmentTitle   String?
  planHash       String
  queryId        String? // the question whose answer carried the offer, when known
  consentAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  totalSteps     Int
  lastStep       Int      @default(0)
  // Two entry shapes share this array, appended in the order they happened:
  //   SUCCESS { i, o: "acted" | "user", in?: "prefill" | "typed" | "chat", c?: true, ms?, p?: true }
  //     — what happened at each step (the agent acted vs. the user did it), where an input's value
  //     came from (an offer prefill · typed into the field · asked-and-answered in the chat),
  //     whether a destructive confirm preceded it, and the step's wall time when the widget could
  //     measure it (absent on resume-completed steps — their duration is unknowable). `p` (EC-7)
  //     = every appearance marker was already on screen BEFORE the act, so the check fell back to
  //     presence — the step passed, but its phrases carried no signal and their quality is suspect.
  //   FAILURE { i, f: "handback" | "rejected" | "marker-miss" | "label-mismatch" | "stall" |
  //     "nav-timeout" | "entry-miss" | "outcome-miss", r?, ms? } (P3-M2, execution-contracts.md
  //     EC-6) — what kind of miss, at which step; failures never bump `lastStep` (they are not
  //     progress), and one step may accrue several before a success entry. `r` is the ONE
  //     page-derived snippet allowed here (the app's own rejection words), scrubbed and clipped
  //     like `safeStopReason`. A new way to fail is a new `f` VALUE, never a new column.
  // NEVER values — those ride the page, not the wire (§A2.4).
  steps           Json     @default("[]")
  outcome         String   @default("active") // active | completed | aborted | safe_stop
  // P3-M2 (EC-5) — the outcome-contract verdict STAMPED beside `completed`, never a fifth outcome
  // value: the steps did complete, and whether the finish looked like the recording is a second
  // fact. null = pre-contract run, a widget that computed no verdict, or any non-completed outcome.
  outcomeVerified Boolean?
  safeStopReason  String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workflowId])
}

model WorkflowOverlapDismissal {
  // P3-M1 — "these are NOT duplicates." Detection compares workflows by content and can be wrong:
  // two unrelated tasks that share their opening navigation once scored 0.757 against each other.
  // When the founder says the detector is wrong, that has to be remembered or the pair is raised at
  // every visit.
  //
  // ⚠️ This is NOT the same decision as "two routes to one goal" — that one groups the workflows
  // under a shared `Workflow.taskId` and makes the copilot ANSWER FROM ONLY ONE of them. Recording a
  // false positive as a grouping would silence half a workspace's knowledge. The two outcomes look
  // alike in the UI and must never be collapsed into one action.
  //
  // The pair is stored in CANONICAL order (lexicographically smaller workflow id first) so it can
  // never be recorded twice under two orderings.
  id           String   @id @default(cuid())
  workspaceId  String
  aWorkflowId  String
  bWorkflowId  String
  decidedById  String?
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([aWorkflowId, bWorkflowId])
  @@index([workspaceId])
}

model CopilotQuery {
  // P1-M10: a logged end-user question to the copilot (feedback loop + analytics).
  id          String   @id @default(cuid())
  workspaceId String
  question    String
  answered    Boolean // true = covered/answered, false = declined
  feedback    String? // up | down | null (thumbs from the widget)
  contextPath String? // P1-M8: host-app path the end-user was on when they asked (e.g. "/settings")
  // P2 Sense — the localization outcome attached to this question (P2-M4 step-friction analytics).
  // A row where the probe localized the user records WHERE ("workflow W, step k") and whether the
  // answer actually USED that position. `senseUsed`: used | ignored (hypotheses sent, answer was
  // about something else — must NOT count as step friction) | none (probe ran, nothing matched —
  // a passive drift signal). Null = pre-Sense row / no probe ran.
  senseSourceId     String?
  senseSegmentIndex Int?
  senseStep         Int? // 1-based step index within the workflow
  senseConfidence   Float?
  senseUsed         String?
  // P2-M5 Reason — why the diagnostic path fired for this question: intent (diagnostic wording) |
  // blocked (the current step's target was disabled) | escalation (the fast path declined and the
  // widget retried with evidence). Null = the fast path answered. `reasonImage` = whether the
  // user's rendered page image rode along on the diagnostic call.
  // What the ANSWER PATH did for this question (2026-07-29). Until these existed the founder could
  // see that a question was declined but nothing about how — a decline after three fruitless
  // searches and a decline with no attempt at all looked identical, and switching a workspace to
  // Copilot mode produced no visible evidence it behaved any differently.
  //
  // `engine` is the one that matters, and it is NOT the same as the workspace's configured mode:
  // the diagnostic path preempts the agent whenever the widget shipped page state, and the safety
  // floor answers with no tools while the mode still reads "copilot". Recording the mode alone
  // would attribute both to the wrong engine. Both are stored so the gap between them is visible.
  //   mode   — the workspace setting at ask time: copilot | agent
  //   engine — what actually produced this answer: agent | reason | floor
  //            "floor" is the one that is NOT a mode — it is the agent's own prompt run for one
  //            round with no tools, after something above it failed. A run of these rows is a
  //            reliability signal, not a configuration one. (Rows written before 2026-08-02 may
  //            read "chatbot": the same engine under the name it had while it was still a tier.)
  //   rounds — model calls made (1 = answered straight from retrieval, no tool use)
  //   toolCalls — tool invocations the model asked for, INCLUDING ones the loop refused
  // Deliberately strings, not enums, and all nullable: pre-2026-07-29 rows keep meaning "unknown"
  // rather than being back-filled with a guess, and a fourth mode slots in without a migration.
  mode        String?
  engine      String?
  rounds      Int?
  toolCalls   Int?
  // WHAT THE QUESTION COST (2026-08-03). The columns above say what the answer path DID; these say
  // what it spent. Until they existed, "what does a question cost to serve?" could only be answered
  // from a provider invoice for the whole workspace — which cannot separate a cheap lookup from an
  // expensive diagnosis, and so cannot price a tier or set a budget.
  //
  // TOTAL FOR THE QUESTION, not for one engine. A question that failed the agent loop and was caught
  // by the floor paid for BOTH, and a loop that searched twice before answering paid for all three
  // calls. Anything scoped to the engine that finally answered would understate exactly the
  // questions worth finding.
  //
  // The two "details" columns are SUBSETS of their neighbours, mirroring the provider's own shape:
  //   inputTokens        — all prompt tokens, cached portion INCLUDED
  //   cachedInputTokens  — the part of inputTokens served from cache, billed at a fraction. These
  //                        prompts are long and stable, so ignoring this OVERSTATES spend badly.
  //   outputTokens       — everything produced, reasoning INCLUDED
  //   reasoningTokens    — the part of outputTokens spent thinking. Bills as output on a reasoning
  //                        model, and explains both why an answer was expensive and the
  //                        `max_output_tokens` failure mode (a budget spent thinking returns empty
  //                        text that reads downstream as an ordinary decline).
  //
  // NOT counted: the embedding call retrieval makes for the question (a separate, tiny request on a
  // different model) and everything the worker spends building the KB. This is the ANSWER path's
  // cost, which is the one that scales with customer traffic.
  //
  // Nullable and never back-filled, like their neighbours: an older row honestly reads "unknown"
  // rather than being given a zero that would drag every average down.
  inputTokens       Int?
  cachedInputTokens Int?
  outputTokens      Int?
  reasoningTokens   Int?
  // WHAT THE MODEL WAS LOOKING AT (2026-08-04). The columns above say what the answer path did and
  // what it spent; these say what it had in front of it — and that is the difference between
  // reading a bad answer and explaining one.
  //
  // Both of the defects that prompted these were INVISIBLE in a row: a workflow evicted from the
  // evidence window by a context boost, and a position chosen arbitrarily from among eight equally
  // scored candidates. Reconstructing either meant re-running retrieval against a live database and
  // trusting it had not changed since — which it had. A question's evidence is a fact about a
  // moment, so it is written down at that moment.
  //
  //   senseCandidates — EVERY position the probe offered, not just the one the answer took:
  //                     [{ key, title, step, conf }]. The whole list, because a wrong winner is
  //                     only diagnosable when the alternatives can be seen. The chosen one (or
  //                     none) is already in the `sense*` columns above.
  //   evidence        — round one's retrieval: { ids, workflows }. Ids join back to KnowledgeItem
  //                     for exactness; the distinct workflow titles ride along because ids DO NOT
  //                     SURVIVE A REPROCESS (the worker delete+recreates items), and a row whose
  //                     ids have all dangled would otherwise say nothing at all.
  //   searches        — the agent's own `search_knowledge` calls WITH what came back:
  //                     [{ q, workflows, ids }]. `toolCalls` counts them and the log line records
  //                     the query; only this says whether the search found the thing. The query is
  //                     model-written from the user's words, so it is scrubbed like `question`.
  //
  // Nullable and never back-filled, like their neighbours. Capped on write — an answer path that
  // searched ten times must not write ten times the row.
  senseCandidates   Json?
  evidence          Json?
  searches          Json?
  reasonTrigger     String?
  reasonImage       Boolean?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  citations QueryCitation[]

  @@index([workspaceId])
}

model CopilotWalkthrough {
  // P4-M0: one row per guided-walkthrough RUN (a session, not a query — the optional queryId keeps
  // the join to the question that offered it). Written by POST /v1/copilot/walkthrough: `started`
  // creates the row (workflow key verified against CopilotApproval first — no-leak), progress
  // events bump lastStep + the auto/manual counters, terminal events set the outcome. A row still
  // `active` past the widget's 30-min session TTL reads as abandoned (no sweeper by design).
  id             String   @id @default(cuid())
  workspaceId    String
  sourceId       String // KnowledgeSource the workflow belongs to
  segmentIndex   Int // the workflow within that source
  segmentTitle   String? // snapshot at start (display/audit, approval-sourced — never the wire)
  queryId        String? // originating CopilotQuery, when known
  startStep      Int // where the user entered (mid-workflow entry via Sense)
  totalSteps     Int
  lastStep       Int // furthest step reached
  autoAdvances   Int      @default(0) // steps detected automatically (measures detection quality for P4-M2)
  manualAdvances Int      @default(0) // steps advanced via the Next button
  outcome        String   @default("active") // active | completed | aborted | stalled
  stalledAtStep  Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model QueryCitation {
  // Analytics: one row per workflow the copilot CITED to answer a question. Powers
  // "Top workflows by citations" (group by sourceId+segmentIndex). Cascades from the
  // parent CopilotQuery (which cascades from Workspace), so workspace delete cleans up.
  //
  // "One row per WORKFLOW" is enforced by the writer (api `citationRows`, 2026-07-27) — before that
  // the answer's per-STEP citation list was persisted one-to-one, so a workflow appeared once per
  // cited step and every reader that counted rows over-counted it. Rows written before that date
  // still hold those duplicates: they are left in place, and the readers in web/lib/analytics.ts
  // count DISTINCT queryId so old and new rows produce the same (correct) numbers. If you add a
  // reader, count distinct questions — do not count rows.
  id           String   @id @default(cuid())
  queryId      String
  workspaceId  String // denormalized for direct per-workspace aggregation (cf. KnowledgeItem)
  // P3-M1 — the durable workflow that was cited. Grouping on this instead of a position is what
  // keeps a workflow's citation history intact when a reprocess moves it.
  // NO foreign key, deliberately: this is a HISTORICAL LOG. It records what happened, and it must
  // survive the workflow being deleted — a cascade here would quietly erase the analytics history
  // of everything a founder ever removed.
  workflowId   String
  sourceId     String // KnowledgeSource the cited workflow belonged to (display / legacy grouping)
  segmentIndex Int? // its position at answer time (KnowledgeItem.segmentIndex)
  segmentTitle String? // snapshot of the workflow title at answer time (display)
  createdAt    DateTime @default(now())

  query CopilotQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([queryId])
  @@index([workflowId])
}
