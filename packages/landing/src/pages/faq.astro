---
// /faq — the full question set, grouped, with FAQPage structured data. Written
// for search and generative engines (the homepage FAQ stays short and
// objection-shaped); the copy rules that govern it live in data/faq-page.ts.
import Base from '../layouts/Base.astro';
import { faqCategories, allPageFaqs } from '../data/faq-page';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allPageFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="FlowBuddy AI FAQ — how it works, setup, accuracy and privacy | FlowBuddy"
  description="Answers to the most common questions about FlowBuddy AI: what it is, how it learns your SaaS product from one recording, how long setup takes, how it stays accurate, and how it handles your data."
  path="/faq"
  jsonLd={[faqJsonLd]}
>
  <section class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(55rem 32rem at 50% -15%, rgba(59, 80, 224, 0.09), transparent 60%);"
      aria-hidden="true"
    >
    </div>
    <div class="relative mx-auto max-w-[820px] px-5 pb-10 pt-12 text-center md:px-8 md:pb-12 md:pt-16">
      <p class="eyebrow mb-5">FAQ</p>
      <h1 class="display-hero">FlowBuddy AI, answered</h1>
      <p class="lead mx-auto mt-6 max-w-2xl">
        What FlowBuddy AI is, how it learns your product from a single recording, what setup
        actually involves, and how it stays inside the knowledge you approved.
      </p>
      <nav class="mt-8 flex flex-wrap justify-center gap-2.5" aria-label="FAQ categories">
        {
          faqCategories.map((c) => (
            <a
              href={`#${c.id}`}
              class="rounded-pill border border-gray-150 bg-white px-4 py-2 text-[0.82rem] font-semibold text-gray-600 shadow-card transition-colors hover:border-brand-200 hover:text-brand-600"
            >
              {c.title}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="border-t border-gray-100 bg-paper">
    <div class="mx-auto max-w-[820px] px-5 py-12 md:px-8 md:py-16">
      <div class="space-y-11">
        {
          faqCategories.map((c) => (
            <div id={c.id} class="scroll-mt-24">
              <h2 class="text-[clamp(1.3rem,2.4vw,1.7rem)] font-extrabold tracking-tight text-ink">
                {c.title}
              </h2>
              <div class="mt-6 space-y-3">
                {c.items.map((f) => (
                  <details class="faq-item rounded-list border border-gray-100 bg-white px-6 py-4 shadow-card">
                    <summary>
                      <h3 class="flex items-center justify-between gap-4 text-[0.98rem] font-bold text-ink">
                        {f.q}
                        <span class="faq-icon grid size-6 shrink-0 place-items-center rounded-pill bg-brand-50 text-brand-500">
                          <svg
                            width="13"
                            height="13"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2.6"
                            stroke-linecap="round"
                          >
                            <path d="M12 5v14M5 12h14" />
                          </svg>
                        </span>
                      </h3>
                    </summary>
                    <p class="mt-3 max-w-[95%] text-[0.9rem] leading-relaxed text-gray-600">
                      {f.a}
                    </p>
                  </details>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <p class="mt-12 text-center text-[0.9rem] leading-relaxed text-gray-500">
        Still have a question? Ask the FlowBuddy assistant on this page — it runs on FlowBuddy —
        or read <a href="/future" class="font-semibold text-brand-500 hover:underline">the road ahead</a>.
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-[820px] px-5 py-12 text-center md:px-8 md:py-16">
      <h2 class="display-section">Show FlowBuddy AI your product once</h2>
      <p class="lead mx-auto mt-4 max-w-xl">
        Record a walkthrough, approve what it learned, paste one snippet. Your users get answers
        where they get stuck — in about 30 minutes.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="https://app.flowbuddyai.com/signup" class="btn-primary">Get started free</a>
        <a href="/#how-it-works" class="btn-secondary">See how it works</a>
      </div>
    </div>
  </section>
</Base>
