---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import KnowledgeBase from '../components/KnowledgeBase.astro';
import Benefits from '../components/Benefits.astro';
import SignupCta from '../components/SignupCta.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/faqs';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="FlowBuddy — the in-app, context-aware AI assistant for your SaaS product"
  description="FlowBuddy is an in-app, context-aware AI assistant for SaaS. Show it your product once — it answers, unblocks, and guides your users in-app. Live in 30 minutes, no coding."
  path="/"
  jsonLd={[faqJsonLd]}
>
  <Hero />
  <HowItWorks />
  <KnowledgeBase />
  <Benefits />
  <SignupCta />
  <Faq />
</Base>
