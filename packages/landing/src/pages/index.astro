---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LayerConcept from '../components/LayerConcept.astro';
import HowItWorks from '../components/HowItWorks.astro';
import KnowledgeBase from '../components/KnowledgeBase.astro';
import Benefits from '../components/Benefits.astro';
import SignupCta from '../components/SignupCta.astro';
import Faq from '../components/Faq.astro';
import { faqs } from '../data/faqs';

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title="FlowBuddy AI — the Application Intelligence Layer for your SaaS"
  description="FlowBuddy learns how your SaaS works and turns it into an application intelligence layer — powering in-app AI assistance, contextual guidance, interactive onboarding, and AI agent execution. Record once, approve, live in 30 minutes."
  path="/"
  jsonLd={[faqJsonLd]}
>
  <Hero />
  <LayerConcept />
  <KnowledgeBase />
  <HowItWorks />
  <Benefits />
  <SignupCta />
  <Faq />
</Base>
