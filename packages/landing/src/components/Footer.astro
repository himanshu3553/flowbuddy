---
import Logo from './Logo.astro';
---

<footer class="border-t border-gray-100 bg-paper">
  <div class="mx-auto max-w-[1140px] px-5 py-14 md:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-xs">
        <a href="/" class="flex items-center gap-2.5" aria-label="FlowBuddy home">
          <Logo size={28} />
          <span class="font-extrabold tracking-tight text-ink">FlowBuddy</span>
        </a>
        <p class="mt-4 text-[0.88rem] leading-relaxed text-gray-500">
          The in-app, context-aware AI assistant for your SaaS product. Record a demo once — go
          live in 30 minutes.
        </p>
      </div>
      <div class="grid grid-cols-2 gap-10 sm:grid-cols-3">
        <div>
          <p class="eyebrow mb-4">Product</p>
          <ul class="space-y-2.5 text-[0.88rem] font-medium text-gray-600">
            <li><a href="/#capabilities" class="hover:text-ink">Capabilities</a></li>
            <li><a href="/#how-it-works" class="hover:text-ink">How it works</a></li>
            <li><a href="/#faq" class="hover:text-ink">FAQ</a></li>
            <li><a href="/future" class="hover:text-ink">The road ahead</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4">Account</p>
          <ul class="space-y-2.5 text-[0.88rem] font-medium text-gray-600">
            <li><a href="https://app.flowbuddyai.com/signup" class="hover:text-ink">Create an account</a></li>
            <li><a href="https://app.flowbuddyai.com" class="hover:text-ink">Sign in to Studio</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-4">Legal</p>
          <ul class="space-y-2.5 text-[0.88rem] font-medium text-gray-600">
            <li><a href="https://app.flowbuddyai.com/privacy" class="hover:text-ink">Privacy</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="mt-12 border-t border-gray-150 pt-6 text-[0.82rem] text-gray-400">
      © 2026 FlowBuddy · Free during early access
    </div>
  </div>
</footer>
