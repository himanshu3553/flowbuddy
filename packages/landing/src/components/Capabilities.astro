---
// Three capability rows: text left, animated HTML product mock right (same
// recreate-in-HTML rule as the hero — never a fake photo). Each mock plays
// once when scrolled into view; the markup is the END state, so no-JS,
// reduced-motion, or any script failure just shows the finished visual.
import Icon from './Icon.astro';
---

<section id="capabilities" class="border-y border-gray-100 bg-paper">
  <div class="mx-auto max-w-[1140px] px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Capabilities</p>
      <h2 class="display-section">One assistant, three ways it helps your users</h2>
      <p class="lead mt-4">
        From a quick answer to a guided product tour, the assistant meets your users where they
        are.
      </p>
    </div>

    <!-- ① Conversational help -->
    <div class="mt-24 grid items-center gap-10 md:mt-36 lg:grid-cols-2 lg:gap-14">
      <div>
        <div class="flex items-center gap-4">
          <Icon name="chat" />
          <span class="eyebrow">Capability 01</span>
        </div>
        <h3 class="mt-5 text-[1.35rem] font-extrabold tracking-tight text-ink md:text-[1.5rem]">
          Conversational help, in your app
        </h3>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-gray-600">
          Your users ask for help and get clear answers right inside your product, in the moment
          they need it the most. No help portal detours, no support requests raised.
        </p>
        <ul class="mt-5 space-y-2.5">
          {
            [
              'Approved answers only and never guesses it',
              'Every answer shows the workflow it came from',
              'Honest "I don’t know yet" when something isn’t covered',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[0.88rem] font-medium leading-snug text-gray-700">
                <svg class="mt-0.5 shrink-0 text-brand-500" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="rounded-dialog border border-gray-150 bg-white p-6 shadow-frame md:p-8"
        data-cap-demo="1"
        aria-hidden="true"
      >
        <div class="mx-auto w-full max-w-[300px] rounded-card border border-gray-100 bg-white shadow-widget">
          <div class="flex items-center gap-2 border-b border-gray-100 px-4 py-3">
            <span
              class="grid size-6 place-items-center rounded-[7px] text-[0.65rem] font-extrabold text-white"
              style="background: linear-gradient(150deg, #4a63e8, #3a50dd)"
              >F</span
            >
            <span class="text-[0.82rem] font-bold text-ink">Help</span>
            <span class="ml-auto flex items-center gap-1.5 text-[0.62rem] font-semibold text-success-text">
              <span class="size-1.5 rounded-full bg-success-dot"></span>Online
            </span>
          </div>
          <div class="space-y-3 px-4 py-4">
            <div
              data-anim="q"
              class="ml-auto w-fit max-w-[85%] rounded-tile bg-brand-500 px-3 py-2 text-[0.76rem] font-medium leading-snug text-white"
            >
              Can I change my billing email?
            </div>
            <div
              data-anim="a"
              class="w-fit max-w-[92%] rounded-tile border border-gray-100 bg-paper px-3 py-2.5 text-[0.76rem] leading-relaxed text-gray-700"
            >
              <span data-anim="dots" class="hidden items-center gap-1 py-1">
                <span class="fb-dot"></span><span class="fb-dot"></span><span class="fb-dot"></span>
              </span>
              Yes — that lives in Settings.
              <span class="mt-1.5 block font-semibold text-ink">1. Open Settings → Billing.</span>
              <span class="block font-semibold text-ink">2. Edit the billing email and save.</span>
              Your next invoice will use it.
              <span
                data-anim="chip"
                class="mt-2 inline-block rounded-pill border border-brand-100 bg-brand-50 px-2 py-0.5 font-mono text-[0.58rem] font-bold uppercase tracking-wide text-brand-600"
                >From: Update billing details</span
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ② Unblocks stuck users -->
    <div class="mt-24 grid items-center gap-10 md:mt-36 lg:grid-cols-2 lg:gap-14">
      <div>
        <div class="flex items-center gap-4">
          <Icon name="spotlight" />
          <span class="eyebrow">Capability 02</span>
        </div>
        <h3 class="mt-5 text-[1.35rem] font-extrabold tracking-tight text-ink md:text-[1.5rem]">
          Unblocks stuck users on the spot
        </h3>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-gray-600">
          When a user gets stuck, the assistant doesn't just describe the fix but points at it.
          It reads where the user is and highlights their next step directly in your UI.
        </p>
        <ul class="mt-5 space-y-2.5">
          {
            [
              'Knows which page the user is on',
              'Highlights the exact next step, right in your interface',
              'Tasks get finished instead of turning into tickets',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[0.88rem] font-medium leading-snug text-gray-700">
                <svg class="mt-0.5 shrink-0 text-brand-500" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="relative mx-auto w-full max-w-[520px] pb-8" data-cap-demo="2" aria-hidden="true">
        <div class="overflow-hidden rounded-dialog border border-gray-150 bg-white shadow-frame">
          <!-- browser chrome -->
          <div class="flex items-center gap-2 border-b border-gray-100 bg-paper-2 px-4 py-2.5">
            <span class="size-2.5 rounded-full bg-gray-200"></span>
            <span class="size-2.5 rounded-full bg-gray-200"></span>
            <span class="size-2.5 rounded-full bg-gray-200"></span>
            <span class="ml-3 rounded-pill bg-white px-3 py-1 font-mono text-[0.62rem] text-gray-400"
              >yoursaas.com/team</span
            >
          </div>
          <div class="flex">
            <!-- host sidebar -->
            <div class="hidden w-[130px] shrink-0 space-y-1 border-r border-gray-100 bg-paper-2 p-3 sm:block">
              <div class="rounded-control px-2.5 py-1.5 text-[0.7rem] font-semibold text-gray-500">
                Dashboard
              </div>
              <div class="rounded-control px-2.5 py-1.5 text-[0.7rem] font-semibold text-gray-500">
                Invoices
              </div>
              <div class="rounded-control bg-gray-100 px-2.5 py-1.5 text-[0.7rem] font-bold text-ink">
                Team
              </div>
              <div class="rounded-control px-2.5 py-1.5 text-[0.7rem] font-semibold text-gray-500">
                Settings
              </div>
            </div>
            <!-- host content -->
            <div class="min-h-[250px] flex-1 p-4">
              <div class="flex items-center justify-between">
                <div class="media-fill h-6 w-2/5 rounded-control"></div>
                <button
                  data-anim="spot"
                  tabindex="-1"
                  class="rounded-control px-3 py-1.5 text-[0.7rem] font-bold text-white ring-2 ring-brand-400 ring-offset-2 transition-all duration-300"
                  style="background: linear-gradient(180deg, #4a63e8, #3a50dd)"
                  >Invite member</button
                >
              </div>
              <div class="mt-4 space-y-2.5">
                {
                  [1, 2, 3].map(() => (
                    <div class="flex items-center gap-3">
                      <div class="media-fill size-7 rounded-pill" />
                      <div class="media-fill h-3.5 w-2/5 rounded-control" />
                      <div class="media-fill ml-auto h-3.5 w-1/5 rounded-control" />
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <!-- the assistant panel -->
        <div
          class="absolute -bottom-8 -right-2 w-[270px] rounded-card border border-gray-100 bg-white shadow-widget sm:-right-5"
        >
          <div class="flex items-center gap-2 border-b border-gray-100 px-4 py-3">
            <span
              class="grid size-6 place-items-center rounded-[7px] text-[0.65rem] font-extrabold text-white"
              style="background: linear-gradient(150deg, #4a63e8, #3a50dd)"
              >F</span
            >
            <span class="text-[0.82rem] font-bold text-ink">Help</span>
            <span class="ml-auto flex items-center gap-1.5 text-[0.62rem] font-semibold text-success-text">
              <span class="size-1.5 rounded-full bg-success-dot"></span>Online
            </span>
          </div>
          <div class="px-4 py-3.5">
            <div
              data-anim="a"
              class="w-fit rounded-tile border border-gray-100 bg-paper px-3 py-2.5 text-[0.74rem] leading-relaxed text-gray-700"
            >
              <span data-anim="dots" class="hidden items-center gap-1 py-1">
                <span class="fb-dot"></span><span class="fb-dot"></span><span class="fb-dot"></span>
              </span>
              You're on Team — to add your teammate, select
              <span class="font-semibold text-ink">Invite member</span>. I've highlighted it for
              you.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ③ Interactive walkthroughs -->
    <div class="mt-24 grid items-center gap-10 md:mt-36 lg:grid-cols-2 lg:gap-14">
      <div>
        <div class="flex items-center gap-4">
          <Icon name="steps" />
          <span class="eyebrow">Capability 03</span>
        </div>
        <h3 class="mt-5 text-[1.35rem] font-extrabold tracking-tight text-ink md:text-[1.5rem]">
          Interactive task walkthroughs
        </h3>
        <p class="mt-3 text-[0.95rem] leading-relaxed text-gray-600">
          For complex tasks the assistant guides users from start to finish, one step at a time.
          It follows their progress and automatically shows them what to do next.
        </p>
        <ul class="mt-5 space-y-2.5">
          {
            [
              'Guides whole tasks, step by step, inside your product',
              'Advances automatically as the user completes each step',
              'Keeps up across pages — the walkthrough continues wherever the task leads',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-[0.88rem] font-medium leading-snug text-gray-700">
                <svg class="mt-0.5 shrink-0 text-brand-500" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 6 9 17l-5-5" />
                </svg>
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div
        class="rounded-dialog border border-gray-150 bg-white p-6 pb-12 shadow-frame md:p-8 md:pb-14"
        data-cap-demo="3"
        aria-hidden="true"
      >
        <div class="relative mx-auto w-full max-w-[400px]">
          <div class="rounded-card border border-gray-150 bg-white p-4">
            <p class="text-[0.8rem] font-bold text-ink">Invite teammate</p>
            <div class="mt-3 space-y-2.5">
              <div class="media-fill h-8 rounded-control"></div>
              <div
                data-anim="spot"
                class="flex h-8 items-center justify-between rounded-control border border-gray-150 bg-white px-2.5 text-[0.7rem] font-semibold text-gray-600 ring-2 ring-brand-400 ring-offset-2 transition-all duration-300"
              >
                Role: Member
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </div>
              <div class="media-fill h-8 w-2/5 rounded-control"></div>
            </div>
          </div>
          <div
            class="absolute -bottom-8 right-0 w-[250px] rounded-card border border-gray-100 bg-white p-4 shadow-widget sm:-right-4"
          >
            <p class="font-mono text-[0.58rem] font-bold uppercase tracking-widest text-brand-500">
              Walkthrough
            </p>
            <div class="mt-1.5 flex items-center justify-between">
              <p class="text-[0.8rem] font-bold text-ink">Add a team member</p>
              <span data-anim="ptext" class="font-mono text-[0.6rem] font-semibold text-gray-500"
                >Step 2 of 3</span
              >
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-pill bg-gray-100">
              <div
                data-anim="bar"
                class="h-full rounded-pill transition-[width] duration-500"
                style="width: 66%; background: linear-gradient(90deg, #4a63e8, #3a50dd)"
              >
              </div>
            </div>
            <div class="mt-3 space-y-2">
              <div class="cap-step" data-anim="step1">
                <span class="cap-badge cap-badge-on">
                  <span data-anim="num" class="hidden">1</span>
                  <svg data-anim="check" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                </span>
                <span class="cap-step-title">Select Invite member</span>
              </div>
              <div class="cap-step cap-step-active" data-anim="step2">
                <span data-anim="badge2" class="cap-badge cap-badge-on">2</span>
                <span class="cap-step-title">Choose a role</span>
              </div>
              <div class="cap-step">
                <span class="cap-badge cap-badge-off">3</span>
                <span class="cap-step-title">Send the invite</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Plays each capability mock once when ~40% visible. Initial-state mutations run
     pre-paint; every early return leaves the static end state untouched. -->
<script is:inline>
  (() => {
    const demos = Array.from(document.querySelectorAll('[data-cap-demo]'));
    if (!demos.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (typeof IntersectionObserver === 'undefined') return;

    const RING = ['ring-2', 'ring-brand-400', 'ring-offset-2'];
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const pick = (d, k) => d.querySelector('[data-anim="' + k + '"]');
    const lock = (el) => {
      el.style.width = el.offsetWidth + 'px';
      el.style.height = el.offsetHeight + 'px';
    };
    const unlock = (el) => {
      el.style.width = '';
      el.style.height = '';
    };
    const textNodes = (root, exclude) => {
      const out = [];
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      while (walker.nextNode()) {
        const n = walker.currentNode;
        if (exclude.some((e) => e && e.contains(n)) || !n.textContent) continue;
        out.push([n, n.textContent]);
      }
      return out;
    };
    const stream = async (nodes) => {
      for (const [n, text] of nodes) {
        for (let i = 0; i < text.length; i += 2) {
          n.textContent = text.slice(0, i + 2);
          await sleep(13);
        }
        n.textContent = text;
      }
    };
    const showDots = async (a, dots, ms) => {
      a.style.visibility = 'visible';
      dots.style.display = 'inline-flex';
      await sleep(ms);
      dots.style.display = 'none';
    };

    const plays = [];

    for (const d of demos) {
      const kind = d.dataset.capDemo;

      if (kind === '1') {
        const q = pick(d, 'q');
        const a = pick(d, 'a');
        const dots = pick(d, 'dots');
        const chip = pick(d, 'chip');
        if (!q || !a || !dots || !chip) continue;
        const qText = (q.textContent || '').trim();
        const nodes = textNodes(a, [chip, dots]);
        lock(q);
        lock(a);
        q.textContent = '';
        q.style.opacity = '0';
        q.style.transition = 'opacity 200ms';
        nodes.forEach(([n]) => (n.textContent = ''));
        a.style.visibility = 'hidden';
        chip.style.opacity = '0';
        chip.style.transition = 'opacity 300ms';
        plays.push([
          d,
          async () => {
            q.style.opacity = '1';
            const caret = document.createElement('span');
            caret.className = 'fb-caret';
            q.appendChild(caret);
            for (const ch of qText) {
              caret.before(ch);
              await sleep(36);
            }
            await sleep(260);
            caret.remove();
            await showDots(a, dots, 750);
            await stream(nodes);
            await sleep(150);
            chip.style.opacity = '1';
            unlock(q);
            unlock(a);
          },
        ]);
      }

      if (kind === '2') {
        const a = pick(d, 'a');
        const dots = pick(d, 'dots');
        const spot = pick(d, 'spot');
        if (!a || !dots || !spot) continue;
        const nodes = textNodes(a, [dots]);
        lock(a);
        nodes.forEach(([n]) => (n.textContent = ''));
        a.style.visibility = 'hidden';
        spot.classList.remove(...RING);
        plays.push([
          d,
          async () => {
            await sleep(300);
            await showDots(a, dots, 700);
            await stream(nodes);
            await sleep(350);
            spot.classList.add(...RING, 'fb-pop');
            unlock(a);
          },
        ]);
      }

      if (kind === '3') {
        const spot = pick(d, 'spot');
        const bar = pick(d, 'bar');
        const ptext = pick(d, 'ptext');
        const step1 = pick(d, 'step1');
        const step2 = pick(d, 'step2');
        const badge2 = pick(d, 'badge2');
        const num = pick(d, 'num');
        const check = pick(d, 'check');
        if (!spot || !bar || !ptext || !step1 || !step2 || !badge2 || !num || !check) continue;
        spot.classList.remove(...RING);
        bar.style.width = '33%';
        ptext.textContent = 'Step 1 of 3';
        step1.classList.add('cap-step-active');
        step2.classList.remove('cap-step-active');
        badge2.classList.remove('cap-badge-on');
        badge2.classList.add('cap-badge-off');
        num.classList.remove('hidden');
        check.classList.add('hidden');
        plays.push([
          d,
          async () => {
            await sleep(900);
            step1.classList.remove('cap-step-active');
            num.classList.add('hidden');
            check.classList.remove('hidden');
            await sleep(350);
            step2.classList.add('cap-step-active');
            badge2.classList.remove('cap-badge-off');
            badge2.classList.add('cap-badge-on');
            bar.style.width = '66%';
            ptext.textContent = 'Step 2 of 3';
            await sleep(400);
            spot.classList.add(...RING, 'fb-pop');
          },
        ]);
      }
    }

    const pending = new Map(plays);
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const play = pending.get(entry.target);
          if (!play) continue;
          pending.delete(entry.target);
          io.unobserve(entry.target);
          play();
        }
      },
      { threshold: 0.4 }
    );
    for (const [el] of plays) io.observe(el);
  })();
</script>
