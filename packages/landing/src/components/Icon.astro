---
// Duotone brand icons: a light indigo back shape (brand-200) + a foreground
// filled with the brand gradient — matching the logo mark and primary CTAs.
// Rendered inside the design system's step-tile treatment (brand-50 tile,
// indigo-tinted shadow). Each gradient id is namespaced per icon name so
// multiple icons on one page never collide.
interface Props {
  name:
    | 'chat'
    | 'spotlight'
    | 'steps'
    | 'record'
    | 'approve'
    | 'live'
    | 'inapp'
    | 'onboard'
    | 'activation'
    | 'tickets';
}
const { name } = Astro.props;
const gid = `fb-ig-${name}`;
---

<span
  class="grid size-12 shrink-0 place-items-center rounded-tile border border-brand-100 bg-brand-50 shadow-step"
  aria-hidden="true"
>
  <svg width="26" height="26" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id={gid} x1="18%" y1="0%" x2="82%" y2="100%">
        <stop offset="0" stop-color="#4a63e8"></stop>
        <stop offset="1" stop-color="#3a50dd"></stop>
      </linearGradient>
    </defs>

    {
      name === 'chat' && (
        <>
          <circle cx="19" cy="5" r="3" fill="#c3ccfb" />
          <path
            d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H13l-4.2 3.6c-.65.56-1.8.1-1.8-.76V16h-.5A2.5 2.5 0 0 1 4 13.5v-7Z"
            fill={`url(#${gid})`}
          />
          <circle cx="9" cy="10" r="1.2" fill="#fff" />
          <circle cx="12" cy="10" r="1.2" fill="#fff" />
          <circle cx="15" cy="10" r="1.2" fill="#fff" />
        </>
      )
    }

    {
      name === 'spotlight' && (
        <>
          <rect x="3" y="5" width="13" height="8" rx="2" fill="#c3ccfb" />
          <path d="M12.5 11.5 21 14.7l-3.7 1.6-1.6 3.7-3.2-8.5Z" fill={`url(#${gid})`} />
        </>
      )
    }

    {
      name === 'steps' && (
        <>
          <path
            d="M5 18 12 12l7-6"
            stroke="#c3ccfb"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"
          />
          <circle cx="5" cy="18" r="2.7" fill={`url(#${gid})`} />
          <circle cx="12" cy="12" r="2.7" fill={`url(#${gid})`} />
          <circle cx="19" cy="6" r="3.1" fill={`url(#${gid})`} />
        </>
      )
    }

    {
      name === 'record' && (
        <>
          <circle cx="12" cy="12" r="8.2" fill="none" stroke="#c3ccfb" stroke-width="2.4" />
          <circle cx="12" cy="12" r="4.4" fill={`url(#${gid})`} />
        </>
      )
    }

    {
      name === 'approve' && (
        <>
          <circle cx="19" cy="5.5" r="3" fill="#c3ccfb" />
          <path
            d="M12 3.2 18.8 5.6v5.1c0 4.4-2.9 7.3-6.8 9.2-3.9-1.9-6.8-4.8-6.8-9.2V5.6L12 3.2Z"
            fill={`url(#${gid})`}
          />
          <path
            d="m8.9 11.7 2.2 2.2 4.2-4.2"
            stroke="#fff"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />
        </>
      )
    }

    {
      name === 'live' && (
        <>
          <path
            d="M6.5 8.5a8 8 0 0 1 11 0"
            stroke="#c3ccfb"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"
          />
          <path
            d="M3.5 5.2a12.3 12.3 0 0 1 17 0"
            stroke="#c3ccfb"
            stroke-width="2.4"
            stroke-linecap="round"
            fill="none"
          />
          <circle cx="12" cy="14.5" r="3.4" fill={`url(#${gid})`} />
          <path
            d="M12 14.5v5.5"
            stroke={`url(#${gid})`}
            stroke-width="2.4"
            stroke-linecap="round"
          />
        </>
      )
    }

    {
      name === 'inapp' && (
        <>
          <rect x="3" y="4" width="18" height="15" rx="2.5" fill="#c3ccfb" />
          <circle cx="6" cy="7" r="0.9" fill="#fff" />
          <circle cx="8.8" cy="7" r="0.9" fill="#fff" />
          <path
            d="M11.5 11.5A2 2 0 0 1 13.5 9.5h5a2 2 0 0 1 2 2v3.4a2 2 0 0 1-2 2h-1.6l-2.6 2.3c-.5.45-1.3.09-1.3-.58V16.9h-.5a2 2 0 0 1-2-2v-3.4Z"
            fill={`url(#${gid})`}
          />
        </>
      )
    }

    {
      name === 'onboard' && (
        <>
          <rect x="5.6" y="3.5" width="2" height="17" rx="1" fill="#c3ccfb" />
          <path d="M9 4.5h10.5l-2.8 3.5 2.8 3.5H9v-7Z" fill={`url(#${gid})`} />
        </>
      )
    }

    {
      name === 'activation' && (
        <>
          <rect x="4" y="13.5" width="3.6" height="6.5" rx="1.2" fill="#c3ccfb" />
          <rect x="10.2" y="9.5" width="3.6" height="10.5" rx="1.2" fill="#c3ccfb" />
          <rect x="16.4" y="4.5" width="3.6" height="15.5" rx="1.2" fill={`url(#${gid})`} />
        </>
      )
    }

    {
      name === 'tickets' && (
        <>
          <path
            d="M3 9.5A2.5 2.5 0 0 1 5.5 7h13A2.5 2.5 0 0 1 21 9.5v5a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 14.5v-5Z"
            fill="#c3ccfb"
          />
          <circle cx="12" cy="7" r="1.5" fill="#eef0fe" />
          <circle cx="12" cy="17" r="1.5" fill="#eef0fe" />
          <circle cx="17.3" cy="15.6" r="4.6" fill={`url(#${gid})`} />
          <path
            d="m15.4 15.6 1.4 1.4 2.4-2.4"
            stroke="#fff"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />
        </>
      )
    }
  </svg>
</span>
