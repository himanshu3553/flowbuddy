---
import Logo from './Logo.astro';
---

<header class="sticky top-0 z-40 border-b border-gray-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-[62px] max-w-[1140px] items-center justify-between px-5 md:px-8">
    <a href="/" class="flex items-center gap-2.5" aria-label="FlowBuddy AI home">
      <Logo size={30} />
      <span class="text-[1.05rem] font-extrabold tracking-tight text-ink">FlowBuddy AI</span>
    </a>
    <nav class="hidden items-center gap-7 text-[0.9rem] font-semibold text-gray-600 md:flex">
      <a href="/#how-it-works" class="transition-colors hover:text-ink">How it works</a>
      <a href="/#knowledge-base" class="transition-colors hover:text-ink">Capabilities</a>
    </nav>
    <div class="flex items-center gap-3">
      <a
        href="https://app.flowbuddyai.com"
        class="hidden text-[0.9rem] font-semibold text-gray-600 transition-colors hover:text-ink sm:block"
        >Sign in</a
      >
      <a
        href="https://app.flowbuddyai.com/signup"
        class="btn-primary !px-5 !py-2.5 !text-[0.88rem]"
        >Get started free</a
      >
    </div>
  </div>
</header>
