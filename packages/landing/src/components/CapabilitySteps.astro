---
// "How it works" for one capability — three numbered cards, the capability
// page's paper band (the shared Record → Approve → Go live story stays on the
// homepage; these steps are specific to the capability being sold).
interface Step {
  title: string;
  body: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  lead?: string;
  steps: Step[];
}

const { eyebrow, heading, lead, steps } = Astro.props;
---

<section class="border-y border-gray-100 bg-paper">
  <div class="mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">{eyebrow}</p>
      <h2 class="display-section">{heading}</h2>
      {lead && <p class="lead mt-4">{lead}</p>}
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((s, i) => (
          <div class="rounded-card border border-gray-100 bg-white p-6 shadow-card">
            <span class="font-mono text-[0.66rem] font-bold uppercase tracking-widest text-brand-500">
              Step {i + 1}
            </span>
            <h3 class="mt-3.5 text-[1.05rem] font-bold tracking-tight text-ink">{s.title}</h3>
            <p class="mt-2.5 text-[0.88rem] leading-relaxed text-gray-600">{s.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
