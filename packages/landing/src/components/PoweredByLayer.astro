---
// The band every capability page carries: this capability is one consumer of
// the application intelligence layer, not a separate tool. Ties back to the
// homepage's centrepiece (the compact card mirrors the pinned one) and
// cross-links the sibling capability pages.
import { capabilities } from '../data/capabilities';

interface Props {
  /** The current page's capability key — excluded from the sibling links. */
  current: 'assistant' | 'guidance' | 'walkthrough' | 'agent';
}

const { current } = Astro.props;
const siblings = capabilities.filter((c) => c.key !== current);
---

<section class="relative border-b border-gray-100">
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(48rem 26rem at 12% -20%, rgba(59, 80, 224, 0.10), transparent 62%),
      radial-gradient(42rem 26rem at 95% 115%, rgba(59, 80, 224, 0.08), transparent 58%);"
    aria-hidden="true"
  >
  </div>
  <div class="relative mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div class="grid items-center gap-10 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <div>
        <p class="eyebrow mb-4">The application intelligence layer</p>
        <h2 class="display-section">One layer powers all of it</h2>
        <p class="lead mt-4">
          This isn't a separate tool to set up. Every capability here reads the same application
          intelligence — the workflows, concepts, and screens FlowBuddy learned from one recording
          of your product, approved by you.
        </p>
        <a
          href="/#knowledge-base"
          class="mt-6 inline-flex items-center gap-1.5 text-[0.94rem] font-semibold text-brand-500 hover:underline"
        >
          See how the layer is built
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
      <div>
        <div
          class="rounded-card px-6 py-6 shadow-primary"
          style="background: linear-gradient(150deg, #4a63e8, #3a50dd)"
        >
          <div class="flex items-center gap-3">
            <span
              class="grid size-10 shrink-0 place-items-center rounded-tile bg-white/15 text-white"
              aria-hidden="true"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 2 9 4.9-9 4.9-9-4.9Z M3 11.9l9 4.9 9-4.9 M3 16.8l9 4.9 9-4.9"></path>
              </svg>
            </span>
            <p class="text-[1.15rem] font-extrabold leading-tight tracking-tight text-white">
              Application Intelligence
            </p>
          </div>
          <div class="mt-3.5 space-y-2" aria-hidden="true">
            {
              [
                ['Workflows', 'how it’s done'],
                ['Concepts', 'what things are'],
                ['Screens', 'where users are'],
              ].map(([t, d]) => (
                <div class="flex items-center gap-2 rounded-control bg-white/12 px-2.5 py-1.5 text-[0.76rem] font-semibold text-white/95">
                  <svg class="shrink-0" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {t} <span class="font-medium text-white/65">· {d}</span>
                </div>
              ))
            }
          </div>
          <div
            class="mt-3 w-fit rounded-pill bg-white px-2.5 py-1 font-mono text-[0.56rem] font-bold uppercase tracking-wider text-brand-600"
          >
            ✓ Approved by you
          </div>
        </div>
        <p class="mt-5 font-mono text-[0.62rem] font-bold uppercase tracking-widest text-gray-400">
          Also powered by this layer
        </p>
        <div class="mt-2.5 grid gap-2.5 sm:grid-cols-3">
          {
            siblings.map((s) => (
              <a
                href={s.slug}
                class="group rounded-tile border border-gray-100 bg-white p-3.5 shadow-card transition-colors hover:border-brand-200"
              >
                <p class="flex items-start justify-between gap-1.5 text-[0.82rem] font-bold leading-snug text-ink">
                  {s.title}
                  {s.beta && (
                    <span class="shrink-0 rounded-pill border border-brand-100 bg-brand-50 px-1.5 py-0.5 font-mono text-[0.5rem] font-bold uppercase tracking-wider text-brand-600">
                      Beta
                    </span>
                  )}
                </p>
                <p class="mt-1.5 flex items-center gap-1 text-[0.76rem] font-semibold text-brand-500">
                  Learn more
                  <svg class="transition-transform group-hover:translate-x-0.5" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
