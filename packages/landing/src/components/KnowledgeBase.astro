---
import MockAssistant from './MockAssistant.astro';
import MockGuidance from './MockGuidance.astro';
import MockWalkthrough from './MockWalkthrough.astro';
import MockAgent from './MockAgent.astro';
import { capabilityByKey } from '../data/capabilities';

// The whole product in one diagram: one recording on the left produces the
// application-intelligence layer, and seven consumers on the right are fed by
// it. On lg the left half PINS and the consumers arrive one per scroll beat —
// the layer is the fixed thing on screen and the uses are what move, which is
// the argument. The pinned card deliberately mirrors the hero pipeline's stage
// 3, so the thing built up there is the thing pinned here.
//
// Pacing is TWO numbers, and the second is the one that survives a content
// change. `lg:min-h-[64vh]` sets the rhythm when a card is short; `lg:py-[4.5vh]`
// holds the gap open when a card is TALLER than the slot — which the four live
// ones are, now that they carry a full capability with its mock. Drop the
// padding and those cards butt straight into each other, because a min-height
// stops doing anything the moment content exceeds it. The stacked layout needs
// its OWN gap (`pb-6`): none of the lg-only padding applies there, so the cards
// touched edge to edge on a phone while desktop looked perfectly spaced. The reveal threshold is
// paired with both, and the pairing is exact: the observer's rootMargin must
// not inset the bottom edge, or a peek smaller than that inset reveals nothing
// and the reader sees an empty gap where the next consumer should be arriving.
//
// Copy guardrail (docs/product/landing-page.md §1): the three unbuilt consumers
// carry a muted "Coming soon" pill, greyscale visuals, and are never written as
// available. AI Agent Execution is live but in BETA — it carries a brand-tinted
// "Beta" pill and its copy always says off-by-default + consented. /future owns
// the fuller road-ahead argument — this links there.
interface Consumer {
  key: string;
  title: string;
  body: string;
  bullets?: string[];
  live: boolean;
  beta?: boolean;
  /** Dedicated capability page (live consumers only). */
  href?: string;
}

const consumers: Consumer[] = [
  {
    key: 'assistant',
    title: 'In-App AI Assistant',
    body: 'Your users ask for help and get clear answers right inside your product, in the moment they need it the most. No help portal detours, no support requests raised.',
    bullets: [
      'Conversational help, in your app',
      'Approved answers only and never guesses it',
      'Honest "I don’t know yet" when something isn’t covered',
    ],
    live: true,
    href: capabilityByKey.assistant.slug,
  },
  {
    key: 'guidance',
    title: 'Contextual Guidance',
    body: 'When a user gets stuck, the assistant doesn’t just describe the fix but points at it. It reads where the user is and highlights their next step directly in your UI.',
    bullets: [
      'Unblocks stuck users on the spot',
      'Knows which page the user is on',
      'Highlights the exact next step, right in your interface',
    ],
    live: true,
    href: capabilityByKey.guidance.slug,
  },
  {
    key: 'walkthrough',
    title: 'Interactive Onboarding',
    body: 'New users learn your product from inside your product. For any approved task the assistant runs a guided walkthrough — one step at a time, following their progress.',
    bullets: [
      'Guides whole tasks, step by step, inside your product',
      'Advances automatically as the user completes each step',
      'Keeps up across pages — it continues wherever the task leads',
    ],
    live: true,
    href: capabilityByKey.walkthrough.slug,
  },
  {
    key: 'agent',
    title: 'AI Agent Execution',
    body: 'The assistant doesn’t just show the steps — with your user’s go-ahead it carries them out: filling fields, clicking through, narrating as it goes. Off by default; you switch it on per workspace.',
    bullets: [
      'Every run starts with your user’s explicit consent',
      'Narrated step by step — your user can stop it at any time',
      'Verifies the outcome before it says done',
    ],
    live: true,
    beta: true,
    href: capabilityByKey.agent.slug,
  },
  {
    key: 'portal',
    title: 'Autogenerated Help Portal',
    body: 'The same approved workflows, published as a searchable help site for your product.',
    live: false,
  },
  {
    key: 'sop',
    title: 'SOP Generation',
    body: 'Your workflows as clean step-by-step documents for training and operations.',
    live: false,
  },
  {
    key: 'agents',
    title: 'Third-Party Agent Access',
    body: 'Outside AI agents — like Claude — reading your approved knowledge to use your product correctly.',
    live: false,
  },
];

// Tile icons: 24×24 strokes drawn at chip scale rather than through Icon.astro,
// whose duotone mark is built for a 48px step tile and reads as noise here.
const paths: Record<string, string> = {
  assistant: 'M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z',
  guidance: 'M5 3l6 17 2.6-6.9L20.5 10z',
  walkthrough: 'M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01',
  agent: 'M13 2 3 14h7l-1 8 10-12h-7z',
  portal: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18m0 0c2.4 2.4 3.6 5.5 3.6 9s-1.2 6.6-3.6 9m0-18C9.6 5.4 8.4 8.5 8.4 12s1.2 6.6 3.6 9M3.5 9h17M3.5 15h17',
  sop: 'M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8zM14 3v5h5M9 13h6M9 17h4',
  agents: 'M7 7h10v10H7zM10 3v2M14 3v2M10 19v2M14 19v2M3 10h2M3 14h2M19 10h2M19 14h2',
};
---

<!-- NOTE: no `overflow-hidden` here. It would clip nothing (the washes are
     inset-0) and would silently break the sticky left column, which stops
     pinning the moment any ancestor becomes a clipping container. -->
<section id="knowledge-base" class="relative border-y border-gray-100">
  <div
    class="pointer-events-none absolute inset-0"
    style="background:
      radial-gradient(48rem 26rem at 15% -20%, rgba(59, 80, 224, 0.10), transparent 62%),
      radial-gradient(42rem 26rem at 95% 110%, rgba(59, 80, 224, 0.09), transparent 58%);"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">One intelligence layer</p>
      <h2 class="display-section">Record once. Power every surface.</h2>
      <p class="lead mt-4">
        Record your product once. FlowBuddy learns your workflows, screens and key product concepts, 
        reviewed and approved by you.
      </p>
    </div>

    <div class="mt-10 grid gap-7 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-start lg:gap-14">
      <!-- Half one — pinned while the consumers scroll past it on lg. -->
      <div class="kb-pinned lg:sticky lg:top-[var(--kb-pin)] lg:self-start" style="--kb-pin: 6rem">
        <p class="font-mono text-[0.68rem] font-bold uppercase tracking-widest">
          <span class="text-brand-500">Step 1</span>
          <span class="text-gray-300">·</span>
          <span class="text-gray-400">Build it once</span>
        </p>
        <div class="relative mt-4">
        <div
          class="kb-anchor rounded-card px-6 py-6 shadow-primary"
          style="background: linear-gradient(150deg, #4a63e8, #3a50dd)"
        >
          <div class="flex items-center gap-3">
            <span
              class="grid size-11 shrink-0 place-items-center rounded-tile bg-white/15 text-white"
              aria-hidden="true"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m12 2 9 4.9-9 4.9-9-4.9Z M3 11.9l9 4.9 9-4.9 M3 16.8l9 4.9 9-4.9"></path>
              </svg>
            </span>
            <p class="text-[1.3rem] font-extrabold leading-tight tracking-tight text-white">
              Application Intelligence
            </p>
          </div>
          <p class="mt-3 text-[0.88rem] font-semibold leading-relaxed text-white/80">
            Learned from one recording of your product.
          </p>
          <div class="mt-3.5 space-y-2" aria-hidden="true">
            {
              [
                ['Workflows', 'how it’s done'],
                ['Concepts', 'what things are'],
                ['Screens', 'where users are'],
              ].map(([t, d]) => (
                <div class="flex items-center gap-2 rounded-control bg-white/12 px-2.5 py-2 text-[0.78rem] font-semibold text-white/95">
                  <svg class="shrink-0" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  {t} <span class="font-medium text-white/65">· {d}</span>
                </div>
              ))
            }
          </div>
          <div
            class="mt-3.5 w-fit rounded-pill bg-white px-2.5 py-1 font-mono text-[0.58rem] font-bold uppercase tracking-wider text-brand-600"
          >
            ✓ Approved by you
          </div>
        </div>

          <!-- Sized to the gutter (lg:gap-14): line, head, line lands on the rail. -->
          <span
            class="pointer-events-none absolute left-full top-1/2 hidden -translate-y-1/2 items-center lg:flex"
            aria-hidden="true"
          >
            <span class="h-px w-3 bg-gray-200"></span>
            <span class="grid size-9 place-items-center rounded-pill border border-gray-150 bg-white text-brand-500 shadow-card">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6" />
              </svg>
            </span>
            <span class="h-px w-3 bg-gray-200"></span>
          </span>
        </div>

        <!-- Only the stacked layout needs the pivot drawn; on lg the pinning says it. -->
        <div class="relative mt-7 flex items-center justify-center lg:hidden" aria-hidden="true">
          <span class="absolute h-14 w-px bg-gray-200"></span>
          <span class="relative grid size-9 rotate-90 place-items-center rounded-pill border border-gray-150 bg-white text-brand-500 shadow-card">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </span>
        </div>
      </div>

      <!-- Half two — one consumer per scroll beat, on a rail that fills as they arrive. -->
      <div>
        <p class="font-mono text-[0.68rem] font-bold uppercase tracking-widest lg:pl-9">
          <span class="text-brand-500">Step 2</span>
          <span class="text-gray-300">·</span>
          <span class="text-gray-400">Use it everywhere</span>
        </p>
        <ul class="relative mt-4">
          <span class="absolute bottom-0 left-[7px] top-0 w-0.5 rounded-pill bg-gray-150" aria-hidden="true"></span>
          <span class="kb-rail-fill absolute left-[7px] top-0 w-0.5 rounded-pill" aria-hidden="true"></span>
          {
            consumers.map((c, i) => (
              <li class={`kb-tile relative pb-6 pl-9 lg:flex lg:min-h-[64vh] lg:py-[4.5vh] ${i === 0 ? 'lg:items-start lg:pt-0' : 'lg:items-center'}`}>
                <span class={`kb-dot absolute left-0 top-6 size-4 rounded-pill border-2 border-white bg-gray-200 shadow-card ${i === 0 ? '' : 'lg:top-1/2 lg:-translate-y-1/2'}`} aria-hidden="true" />
                <div
                  class={`kb-card w-full rounded-card border p-5 md:p-6 ${
                    c.live ? 'border-gray-100 bg-white shadow-card' : 'border-gray-150 bg-paper-2'
                  }`}
                >
                  <div class="flex flex-col-reverse items-start gap-2 sm:flex-row sm:items-center sm:justify-between sm:gap-3">
                    <div class="flex min-w-0 items-center gap-3">
                      <span
                        class={`grid size-10 shrink-0 place-items-center rounded-tile ${
                          c.live ? 'bg-brand-50 text-brand-500' : 'bg-gray-100 text-gray-400'
                        }`}
                      >
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                          <path d={paths[c.key]} />
                        </svg>
                      </span>
                      {/* h3 because these tiles now carry the capability headings the
                          deleted Capabilities section used to hold. */}
                      <h3
                        class={`text-[1.15rem] font-bold leading-snug tracking-tight md:text-[1.3rem] ${
                          c.live ? 'text-ink' : 'text-gray-500'
                        }`}
                      >
                        {c.title}
                      </h3>
                    </div>
                    {c.beta && (
                      <span class="shrink-0 rounded-pill border border-brand-200 bg-brand-50 px-2.5 py-1 font-mono text-[0.58rem] font-bold uppercase tracking-wider text-brand-600">
                        Beta
                      </span>
                    )}
                    {!c.live && (
                      <span class="shrink-0 rounded-pill border border-gray-150 bg-white px-2.5 py-1 font-mono text-[0.58rem] font-bold uppercase tracking-wider text-gray-500">
                        Coming soon
                      </span>
                    )}
                  </div>
                  <p class="mt-3.5 text-[0.92rem] leading-relaxed text-gray-600">{c.body}</p>
                  {c.bullets && (
                    <ul class="mt-4 space-y-2.5">
                      {c.bullets.map((item) => (
                        <li class="flex items-start gap-2.5 text-[0.88rem] font-medium leading-snug text-gray-700">
                          <svg class="mt-0.5 shrink-0 text-brand-500" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 6 9 17l-5-5" />
                          </svg>
                          {item}
                        </li>
                      ))}
                    </ul>
                  )}

                  {/* The four live consumers carry the real animated mocks;
                      the unbuilt three keep a greyscale placeholder, so no picture
                      on this page can read as a shipped screen. */}
                  {c.live ? (
                    <>
                      <div class="mt-5">
                        {c.key === 'assistant' && <MockAssistant />}
                        {c.key === 'guidance' && <MockGuidance />}
                        {c.key === 'walkthrough' && <MockWalkthrough />}
                        {c.key === 'agent' && <MockAgent />}
                      </div>
                      {c.href && (
                        <a
                          href={c.href}
                          class="mt-4 inline-flex items-center gap-1.5 text-[0.9rem] font-semibold text-brand-500 hover:underline"
                        >
                          Explore {c.title}
                          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14M13 6l6 6-6 6" />
                          </svg>
                        </a>
                      )}
                    </>
                  ) : (
                    <div class="mt-5 rounded-tile border border-gray-150 bg-white p-3.5" aria-hidden="true">
                    {c.key === 'portal' && (
                      <div class="rounded-tile border border-gray-150 bg-paper-2 p-3">
                        <div class="flex items-center gap-2 rounded-pill border border-gray-150 bg-white px-2.5 py-1.5">
                          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" class="text-gray-300">
                            <circle cx="11" cy="11" r="7" />
                            <path d="M20 20l-4-4" stroke-linecap="round" />
                          </svg>
                          <span class="block h-1.5 w-1/3 rounded-pill bg-gray-150" />
                        </div>
                        <div class="mt-2.5 space-y-1.5">
                          {[0, 1, 2].map((i) => (
                            <div class="flex items-center gap-2 rounded-[7px] border border-gray-150 bg-white px-2 py-2">
                              <span class="size-1.5 shrink-0 rounded-pill bg-gray-200" />
                              <span class={`block h-1.5 rounded-pill bg-gray-150 ${['w-3/5', 'w-4/5', 'w-2/5'][i]}`} />
                              <span class="ml-auto text-[0.6rem] text-gray-300">›</span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {c.key === 'sop' && (
                      <div class="rounded-tile border border-gray-150 bg-white p-3">
                        <div class="flex items-center justify-between border-b border-gray-100 pb-2">
                          <span class="block h-1.5 w-1/3 rounded-pill bg-gray-200" />
                          <span class="rounded-pill border border-gray-150 px-1.5 py-0.5 font-mono text-[0.5rem] font-bold uppercase tracking-wider text-gray-400">
                            .docx
                          </span>
                        </div>
                        <div class="mt-2.5 space-y-2">
                          {[0, 1, 2].map((i) => (
                            <div class="flex items-start gap-2">
                              <span class="grid size-4 shrink-0 place-items-center rounded-pill bg-gray-100 font-mono text-[0.5rem] font-bold text-gray-500">
                                {i + 1}
                              </span>
                              <span class="mt-1 flex-1 space-y-1">
                                <span class="block h-1.5 w-full rounded-pill bg-gray-100" />
                                <span class={`block h-1.5 rounded-pill bg-gray-100 ${['w-3/4', 'w-1/2', 'w-2/3'][i]}`} />
                              </span>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {c.key === 'agents' && (
                      <div class="rounded-tile border border-gray-150 bg-white p-3">
                        <div class="flex items-center gap-2 border-b border-gray-100 pb-2">
                          <span class="rounded-[6px] bg-gray-100 px-1.5 py-0.5 font-mono text-[0.52rem] font-bold uppercase tracking-wider text-gray-500">
                            AI agent
                          </span>
                          <span class="text-[0.6rem] text-gray-300">→</span>
                          <span class="rounded-[6px] bg-gray-100 px-1.5 py-0.5 font-mono text-[0.52rem] font-bold uppercase tracking-wider text-gray-500">
                            Approved KB
                          </span>
                        </div>
                        <div class="mt-2.5 space-y-1.5 font-mono text-[0.56rem] text-gray-400">
                          <p>read: workflows[]</p>
                          <div class="space-y-1.5">
                            {[0, 1].map((i) => (
                              <div class="flex items-center gap-2 rounded-[7px] border border-gray-150 bg-paper-2 px-2 py-1.5">
                                <span class="size-1.5 shrink-0 rounded-pill bg-gray-200" />
                                <span class={`block h-1.5 rounded-pill bg-gray-150 ${['w-1/2', 'w-2/3'][i]}`} />
                                <span class="ml-auto rounded-pill border border-gray-150 px-1.5 text-[0.5rem] uppercase text-gray-400">
                                  approved
                                </span>
                              </div>
                            ))}
                          </div>
                        </div>
                      </div>
                    )}
                    </div>
                  )}
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="mt-8 text-[0.86rem] leading-relaxed text-gray-500">
      The first four are live today — AI Agent Execution is in beta and off by default. The rest
      are in development — <a
        href="/future"
        class="font-semibold text-brand-500 hover:underline">see the road ahead</a
      >.
    </p>
  </div>
</section>

<script is:inline>
  // The markup above IS the finished state — every consumer visible, rail full.
  // This opts the section into the hidden start state and reveals one tile at a
  // time, so no-JS, a script failure, a crawler and reduced-motion all still get
  // the complete diagram (design-system rule, as with the animated mocks).
  (() => {
    const root = document.getElementById('knowledge-base');
    if (!root) return;

    // Where the block must pin so the blue tile lands dead centre. Measured
    // rather than hard-coded: the tile's height moves with its copy, and a
    // stale constant would silently stop centring it.
    const pinned = root.querySelector('.kb-pinned');
    const anchor = pinned && pinned.querySelector('.kb-anchor');
    const setPin = () => {
      if (!pinned || !anchor) return;
      const lead = anchor.getBoundingClientRect().top - pinned.getBoundingClientRect().top;
      const top = Math.max(16, (window.innerHeight - anchor.offsetHeight) / 2 - lead);
      pinned.style.setProperty('--kb-pin', `${Math.round(top)}px`);
    };
    setPin();
    window.addEventListener('resize', setPin);

    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    root.setAttribute('data-kb-reveal', '');
    const tiles = Array.from(root.querySelectorAll('.kb-tile'));
    const fill = root.querySelector('.kb-rail-fill');
    let reached = 0;

    const paint = () => {
      if (fill) fill.style.height = `${(reached / tiles.length) * 100}%`;
    };

    // Observe the CARD, not its scroll slot: the slot is most of a viewport tall
    // and would cross any threshold long before the card itself is on screen.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const tile = entry.target.closest('.kb-tile');
          if (!tile) continue;
          tile.classList.add('is-in');
          io.unobserve(entry.target);
          reached = Math.max(reached, tiles.indexOf(tile) + 1);
          paint();
        }
      },
      { threshold: 0, rootMargin: '0px' }
    );
    tiles.forEach((t) => {
      const card = t.querySelector('.kb-card');
      if (card) io.observe(card);
    });
    paint();
  })();
</script>

<!-- Plays each capability mock once when ~40% visible. Initial-state mutations run
     pre-paint; every early return leaves the static end state untouched. -->
<script is:inline>
  (() => {
    const demos = Array.from(document.querySelectorAll('[data-cap-demo]'));
    if (!demos.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (typeof IntersectionObserver === 'undefined') return;

    const RING = ['ring-2', 'ring-brand-400', 'ring-offset-2'];
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
    const pick = (d, k) => d.querySelector('[data-anim="' + k + '"]');
    const lock = (el) => {
      el.style.width = el.offsetWidth + 'px';
      el.style.height = el.offsetHeight + 'px';
    };
    const unlock = (el) => {
      el.style.width = '';
      el.style.height = '';
    };
    const textNodes = (root, exclude) => {
      const out = [];
      const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
      while (walker.nextNode()) {
        const n = walker.currentNode;
        if (exclude.some((e) => e && e.contains(n)) || !n.textContent) continue;
        out.push([n, n.textContent]);
      }
      return out;
    };
    const stream = async (nodes) => {
      for (const [n, text] of nodes) {
        for (let i = 0; i < text.length; i += 2) {
          n.textContent = text.slice(0, i + 2);
          await sleep(13);
        }
        n.textContent = text;
      }
    };
    const showDots = async (a, dots, ms) => {
      a.style.visibility = 'visible';
      dots.style.display = 'inline-flex';
      await sleep(ms);
      dots.style.display = 'none';
    };

    const plays = [];

    for (const d of demos) {
      const kind = d.dataset.capDemo;

      if (kind === '1') {
        const q = pick(d, 'q');
        const a = pick(d, 'a');
        const dots = pick(d, 'dots');
        const chip = pick(d, 'chip');
        if (!q || !a || !dots || !chip) continue;
        const qText = (q.textContent || '').trim();
        const nodes = textNodes(a, [chip, dots]);
        lock(q);
        lock(a);
        q.textContent = '';
        q.style.opacity = '0';
        q.style.transition = 'opacity 200ms';
        nodes.forEach(([n]) => (n.textContent = ''));
        a.style.visibility = 'hidden';
        chip.style.opacity = '0';
        chip.style.transition = 'opacity 300ms';
        plays.push([
          d,
          async () => {
            q.style.opacity = '1';
            const caret = document.createElement('span');
            caret.className = 'fb-caret';
            q.appendChild(caret);
            for (const ch of qText) {
              caret.before(ch);
              await sleep(36);
            }
            await sleep(260);
            caret.remove();
            await showDots(a, dots, 750);
            await stream(nodes);
            await sleep(150);
            chip.style.opacity = '1';
            unlock(q);
            unlock(a);
          },
        ]);
      }

      if (kind === '2') {
        const a = pick(d, 'a');
        const dots = pick(d, 'dots');
        const spot = pick(d, 'spot');
        if (!a || !dots || !spot) continue;
        const nodes = textNodes(a, [dots]);
        lock(a);
        nodes.forEach(([n]) => (n.textContent = ''));
        a.style.visibility = 'hidden';
        spot.classList.remove(...RING);
        plays.push([
          d,
          async () => {
            await sleep(300);
            await showDots(a, dots, 700);
            await stream(nodes);
            await sleep(350);
            spot.classList.add(...RING, 'fb-pop');
            unlock(a);
          },
        ]);
      }

      if (kind === '3') {
        const spot = pick(d, 'spot');
        const bar = pick(d, 'bar');
        const ptext = pick(d, 'ptext');
        const step1 = pick(d, 'step1');
        const step2 = pick(d, 'step2');
        const badge2 = pick(d, 'badge2');
        const num = pick(d, 'num');
        const check = pick(d, 'check');
        if (!spot || !bar || !ptext || !step1 || !step2 || !badge2 || !num || !check) continue;
        spot.classList.remove(...RING);
        bar.style.width = '33%';
        ptext.textContent = 'Step 1 of 3';
        step1.classList.add('cap-step-active');
        step2.classList.remove('cap-step-active');
        badge2.classList.remove('cap-badge-on');
        badge2.classList.add('cap-badge-off');
        num.classList.remove('hidden');
        check.classList.add('hidden');
        plays.push([
          d,
          async () => {
            await sleep(900);
            step1.classList.remove('cap-step-active');
            num.classList.add('hidden');
            check.classList.remove('hidden');
            await sleep(350);
            step2.classList.add('cap-step-active');
            badge2.classList.remove('cap-badge-off');
            badge2.classList.add('cap-badge-on');
            bar.style.width = '66%';
            ptext.textContent = 'Step 2 of 3';
            await sleep(400);
            spot.classList.add(...RING, 'fb-pop');
          },
        ]);
      }

      // The agent run: consent → the agent acts and narrates → verified done.
      if (kind === '4') {
        const email = pick(d, 'ag-email');
        const send = pick(d, 'ag-send');
        const prog = pick(d, 'ag-prog');
        const status = pick(d, 'ag-status');
        const done = pick(d, 'ag-done');
        const run = pick(d, 'ag-run');
        const stop = pick(d, 'ag-stop');
        if (!email || !send || !prog || !status || !done || !run || !stop) continue;
        const emailText = (email.textContent || '').trim();
        email.textContent = '';
        send.classList.remove(...RING);
        prog.textContent = '0/3';
        done.classList.add('hidden');
        status.textContent = 'Ready — waiting for your user’s go-ahead.';
        run.classList.remove('hidden');
        plays.push([
          d,
          async () => {
            await sleep(500);
            run.classList.add('fb-pop');
            await sleep(520);
            run.classList.add('hidden');
            stop.classList.remove('hidden');
            prog.textContent = '1/3';
            status.textContent = 'Opening the Team page…';
            await sleep(780);
            prog.textContent = '2/3';
            status.textContent = 'Typing the email address…';
            for (const ch of emailText) {
              email.textContent += ch;
              await sleep(36);
            }
            await sleep(320);
            prog.textContent = '3/3';
            status.textContent = 'Clicking “Send invite”…';
            send.classList.add(...RING, 'fb-pop');
            await sleep(750);
            stop.classList.add('hidden');
            done.classList.remove('hidden');
            status.textContent = 'Done — outcome verified.';
          },
        ]);
      }
    }

    const pending = new Map(plays);
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const play = pending.get(entry.target);
          if (!play) continue;
          pending.delete(entry.target);
          io.unobserve(entry.target);
          play();
        }
      },
      { threshold: 0.4 }
    );
    for (const [el] of plays) io.observe(el);
  })();
</script>
