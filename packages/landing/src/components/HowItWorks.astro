---
import Icon from './Icon.astro';

const steps = [
  {
    icon: 'record' as const,
    title: 'Record',
    body: 'Give FlowBuddy a demo. Click through your product once while our Chrome recorder watches — like showing a new teammate around.',
    safeguard: 'Sensitive data is masked in your browser before anything leaves it.',
  },
  {
    icon: 'approve' as const,
    title: 'Approve',
    body: 'FlowBuddy automatically turns your demo into product knowledge and step-by-step workflows. You review and approve each one.',
    safeguard: 'The assistant can only ever say what you approved.',
  },
  {
    icon: 'live' as const,
    title: 'Go live',
    body: 'Your custom AI assistant is ready in minutes, not days. Paste one small snippet into your app and it goes live for every user, instantly.',
    safeguard: 'It floats above your product — no code changes, no redesign.',
  },
];
---

<section id="how-it-works">
  <div class="mx-auto max-w-[1140px] px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">How it works</p>
      <h2 class="display-section">Your product demo is the whole setup</h2>
      <p class="lead mt-4">
        No knowledge base to write, no flows to script, no SDK to integrate. Show FlowBuddy your
        product once and it does the rest.
      </p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((s, i) => (
          <div class="rounded-card border border-gray-100 bg-white p-6 shadow-card">
            <div class="flex items-center justify-between">
              <Icon name={s.icon} />
              <span class="font-mono text-[0.66rem] font-bold uppercase tracking-widest text-brand-500">
                Step {i + 1}
              </span>
            </div>
            <h3 class="mt-4 text-[1.05rem] font-bold tracking-tight text-ink">{s.title}</h3>
            <p class="mt-2.5 text-[0.88rem] leading-relaxed text-gray-600">{s.body}</p>
            <p class="mt-3.5 flex items-start gap-1.5 text-[0.8rem] font-medium leading-snug text-gray-500">
              <svg class="mt-0.5 shrink-0 text-success-dot" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {s.safeguard}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
