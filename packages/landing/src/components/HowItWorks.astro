---
import Icon from './Icon.astro';

const steps = [
  {
    icon: 'record' as const,
    title: 'Record',
    body: 'Record a walkthrough of your product with our Chrome extension, just like onboarding a new teammate.',
    safeguard: 'Sensitive information is masked directly in your browser before any data is sent.',
  },
  {
    icon: 'approve' as const,
    title: 'Approve',
    body: 'FlowBuddy converts your walkthrough into structured application intelligence — clear product knowledge and step-by-step workflows, ready for you to review and approve.',
    safeguard: 'Every capability only uses knowledge you’ve reviewed and approved.',
  },
  {
    icon: 'live' as const,
    title: 'Go live',
    body: 'Your custom AI assistant is ready in minutes, not days. Paste one small snippet into your app and it goes live for every user, instantly.',
    safeguard: 'It sits seamlessly on your product. No code change is required.',
  },
];
---

<!-- White ground: this section sits between the brand-tinted layer section and
     the paper Benefits band, so the position's band is white (the alternation
     rule — the ground belongs to the position, not the section). -->
<section id="how-it-works" class="border-b border-gray-100">
  <div class="mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">How it works</p>
      <h2 class="display-section">Your product demo is the whole setup</h2>
      <p class="lead mt-4">
        No knowledge base to write, no SDK to integrate. Just show FlowBuddy your product once
        and it does the rest.
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        steps.map((s, i) => (
          <div class="rounded-card border border-gray-100 bg-white p-6 shadow-card">
            <div class="flex items-center justify-between">
              <Icon name={s.icon} />
              <span class="font-mono text-[0.66rem] font-bold uppercase tracking-widest text-brand-500">
                Step {i + 1}
              </span>
            </div>
            <h3 class="mt-4 text-[1.05rem] font-bold tracking-tight text-ink">{s.title}</h3>
            <p class="mt-2.5 text-[0.88rem] leading-relaxed text-gray-600">{s.body}</p>
            <p class="mt-3.5 flex items-start gap-1.5 text-[0.8rem] font-medium leading-snug text-gray-500">
              <svg class="mt-0.5 shrink-0 text-success-dot" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {s.safeguard}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
