---
// "What is the Application Intelligence Layer" — the explainer directly under
// the hero, replicating the founder's reference image on the design tokens
// (design-system rule: recreated in HTML, never an image): the SaaS stack
// every builder knows — Data → API → UI — as isometric glass slabs with their
// icon + caption ON the slab plane, and the Intelligence Layer lifted above
// the stack as a simple flat horizontal card (founder call 2026-08-17) —
// indigo glass, NEW LAYER badge, five capability tiles, light beams dropping
// into the UI slab. The markup is the settled end state; the script only adds
// the rise-in reveal.

const slabs = [
  {
    label: 'UI Layer',
    icon: 'M3 5h18v14H3zM3 9h18M6.5 7h.01',
    pos: 'top-[140px] sm:top-[155px]',
    delay: 340,
    z: 'z-30',
    bg: 'linear-gradient(135deg, #ffffff, #fafbfc)',
  },
  {
    label: 'API Layer',
    icon: 'm9 8-4 4 4 4M15 8l4 4-4 4',
    pos: 'top-[190px] sm:top-[217px]',
    delay: 220,
    z: 'z-20',
    bg: 'linear-gradient(135deg, #fafbfc, #f6f7f9)',
  },
  {
    label: 'Data Layer',
    icon: 'M12 8c4.4 0 8-1.3 8-3s-3.6-3-8-3-8 1.3-8 3 3.6 3 8 3Zm8-3v14c0 1.7-3.6 3-8 3s-8-1.3-8-3V5m16 7c0 1.7-3.6 3-8 3s-8-1.3-8-3',
    pos: 'top-[240px] sm:top-[279px]',
    delay: 100,
    z: 'z-10',
    bg: 'linear-gradient(135deg, #f6f7f9, #eceef3)',
  },
];

const tiles = [
  ['Understand Workflows', 'M9 3h6v4H9zM12 7v3M5 10h14M5 10v3M19 10v3M2 17h6v4H2zM16 17h6v4h-6zM5 13v4M19 13v4'],
  ['Provide Guidance', 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4 6-2.5 5.5L8 16l2.5-5.5Z'],
  ['Deliver Support', 'M21 15a2 2 0 0 1-2 2H8l-4 4V5a2 2 0 0 1 2-2h13a2 2 0 0 1 2 2z'],
  ['Drive Analytics', 'M5 20v-6M11 20V8M17 20v-9M3 20h18'],
  ['AI Agents', 'M7 7h10v10H7zM10 3v2M14 3v2M10 19v2M14 19v2M3 10h2M3 14h2M19 10h2M19 14h2'],
];
---

<!-- overflow-x-clip: the dot-grid ground (and slab shadows) bleed past the
     column on small screens and would otherwise widen the whole page. -->
<section id="intelligence-layer" class="overflow-x-clip border-y border-gray-100 bg-paper">
  <div class="mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div class="grid items-center gap-12 lg:grid-cols-[1fr_1.05fr] lg:gap-10">
      <div>
        <p class="eyebrow mb-4">What it is</p>
        <h2 class="display-section">A new layer in your SaaS stack</h2>
        <p class="lead mt-4">
          Every SaaS is built in three layers including Data, API & UI. FlowBuddy adds the missing one on top:
          the <strong class="font-bold text-ink">Application Intelligence Layer</strong>, a living
          map of how your product actually works.
        </p>
        <div class="mt-6 border-l-2 border-brand-200 pl-4">
          <p class="text-[0.95rem] font-bold text-ink">Why modern SaaS needs it</p>
          <p class="mt-1.5 text-[0.9rem] leading-relaxed text-gray-600">
            Your users do not want to search through documentation every time they need help. 
            And AI agents cannot reliably understand your product just by clicking around the UI.</br>
            They both need a clear understanding of how your product works and how things get done. FlowBuddy puts that knowledge into one structured and approved layer that can power user assistance, onboarding, support and AI agents.
          </p>
        </div>
        <p class="mt-6 font-mono text-[0.72rem] font-bold uppercase tracking-widest text-brand-500">
          Capture workflows → turn them into application intelligence
        </p>
      </div>

      <!-- The stack: three familiar slabs, and the new one lifted above them. -->
      <div class="relative" data-layer-stack>
        <div class="pipe-dotgrid pointer-events-none absolute -inset-x-4 -inset-y-6" aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute left-1/2 top-[34%] h-[240px] w-[420px] max-w-full -translate-x-1/2 -translate-y-1/2 rounded-full blur-[80px]"
          style="background: rgba(59, 80, 224, 0.13)"
          aria-hidden="true"
        >
        </div>
        <div class="relative mx-auto h-[440px] w-full max-w-[500px] sm:h-[520px]" aria-hidden="true">
          <!-- the new layer: the same slab language, lifted and glowing -->
          <div class="fb-stack-item absolute inset-x-1 top-0 z-40 sm:inset-x-5" style="--d: 520ms">
            <div class="pipe-float">
              <div
                class="relative overflow-hidden rounded-[1.75rem] border border-white/35 px-4 pb-4 pt-4 sm:px-5"
                style="background: linear-gradient(150deg, #4a63e8, #3a50dd); box-shadow: 0 2px 10px rgba(58, 80, 221, 0.3), 0 0 54px 8px rgba(58, 80, 221, 0.28)"
              >
                <span class="pipe-sheen"></span>
                <span
                  class="absolute right-3.5 top-3.5 rounded-[8px] bg-white px-2 py-1 text-center font-mono text-[0.52rem] font-extrabold uppercase leading-[1.3] tracking-wider text-brand-600"
                  >New<br />Layer</span
                >
                <div class="relative flex items-center gap-3 pr-14">
                  <span class="grid size-10 shrink-0 place-items-center rounded-[10px] border border-white/30 bg-white/12 text-white">
                    <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"></path>
                      <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"></path>
                      <path d="M12 5v13"></path>
                    </svg>
                  </span>
                  <div class="min-w-0">
                    <p class="text-[1.18rem] font-extrabold leading-tight tracking-tight text-white">
                      Intelligence Layer
                    </p>
                    <p class="text-[0.72rem] font-semibold text-brand-200">Understands. Guides. Acts.</p>
                  </div>
                </div>
                <div class="relative mt-3.5 grid grid-cols-5 gap-1.5">
                  {
                    tiles.map(([label, d]) => (
                      <span class="flex flex-col items-center gap-1.5 rounded-[10px] border border-white/25 bg-white/10 px-1 py-2 text-center">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                          <path d={d} />
                        </svg>
                        <span class="text-[0.52rem] font-semibold leading-[1.25] text-white/90">{label}</span>
                      </span>
                    ))
                  }
                </div>
              </div>
            </div>
            <!-- light beams dropping into the UI slab just beneath -->
            <span class="fb-beam left-[30%] top-full h-9" style="animation-delay: 0s"></span>
            <span class="fb-beam left-1/2 top-full h-8" style="animation-delay: 0.35s"></span>
            <span class="fb-beam left-[70%] top-full h-10" style="animation-delay: 0.7s"></span>
          </div>

          <!-- the familiar stack, captions on the slab plane -->
          {
            slabs.map((s) => (
              <div class={`fb-stack-item absolute inset-x-0 ${s.pos} ${s.z}`} style={`--d: ${s.delay}ms`}>
                <div class="fb-slab" style={`background: ${s.bg}`} />
                <div class="fb-slab-label left-[calc(50%-116px)] top-[100px] sm:left-[calc(50%-148px)] sm:top-[128px]">
                  <div class="flex items-center gap-3">
                    <span class="grid size-8 shrink-0 place-items-center rounded-[10px] border-[1.5px] border-gray-300 bg-white text-gray-600 sm:size-10">
                      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d={s.icon} />
                      </svg>
                    </span>
                    <span class="whitespace-nowrap text-[0.98rem] font-extrabold tracking-tight text-ink sm:text-[1.15rem]">
                      {s.label}
                    </span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Rise-in reveal on first view. The markup IS the settled stack — this only
     opts into the hidden start state when IO + motion are available, so no-JS,
     reduced-motion and crawlers get the finished visual. -->
<script is:inline>
  (() => {
    const root = document.querySelector('[data-layer-stack]');
    if (!root) return;
    if (!('IntersectionObserver' in window)) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    root.setAttribute('data-stack-reveal', '');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          root.classList.add('is-in');
          io.disconnect();
        }
      },
      { threshold: 0.3 }
    );
    io.observe(root);
  })();
</script>
