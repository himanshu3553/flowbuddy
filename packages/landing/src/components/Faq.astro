---
import { faqs } from '../data/faqs';
---

<section id="faq" class="border-t border-gray-100 bg-paper">
  <div class="mx-auto max-w-[820px] px-5 py-12 md:px-8 md:py-16">
    <div class="text-center">
      <p class="eyebrow mb-4">FAQ</p>
      <h2 class="display-section">Questions founders ask us</h2>
    </div>
    <div class="mt-8 space-y-3">
      {
        faqs.map((f) => (
          <details class="faq-item rounded-list border border-gray-100 bg-white px-6 py-4 shadow-card">
            <summary class="flex items-center justify-between gap-4 text-[0.98rem] font-bold text-ink">
              {f.q}
              <span class="faq-icon grid size-6 shrink-0 place-items-center rounded-pill bg-brand-50 text-brand-500">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round">
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-[95%] text-[0.9rem] leading-relaxed text-gray-600">
              {f.q === 'Does FlowBuddy work with AI agents?' ? (
                <>
                  That is where FlowBuddy is heading: the same approved knowledge base that powers
                  your in-app assistant is being built to make your product usable by AI agents
                  too. See <a href="/future" class="font-semibold text-brand-500 hover:underline">the road ahead</a>.
                </>
              ) : (
                f.a
              )}
            </p>
          </details>
        ))
      }
    </div>
    <p class="mt-8 text-center text-[0.9rem] text-gray-500">
      More questions?
      <a href="/faq" class="font-semibold text-brand-500 hover:underline">Read the full FAQ</a>
    </p>
  </div>
</section>
