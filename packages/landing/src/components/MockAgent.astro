---
// Animated product mock — the AI agent carrying out a consented run. Recreated in
// HTML on the tokens (design-system rule: never a fake photo). The markup IS the
// finished state — the run complete and verified; the player that animates it
// (consent → narrated steps → verified done) lives with the section that renders
// this, so no-JS and reduced-motion show the completed visual.
---

<div class="relative mx-auto w-full max-w-[520px] pb-10" data-cap-demo="4" aria-hidden="true">
  <div class="overflow-hidden rounded-dialog border border-gray-150 bg-white shadow-frame">
    <!-- browser chrome -->
    <div class="flex items-center gap-2 border-b border-gray-100 bg-paper-2 px-4 py-2.5">
      <span class="size-2.5 rounded-full bg-gray-200"></span>
      <span class="size-2.5 rounded-full bg-gray-200"></span>
      <span class="size-2.5 rounded-full bg-gray-200"></span>
      <span class="ml-3 rounded-pill bg-white px-3 py-1 font-mono text-[0.62rem] text-gray-400"
        >yoursaas.com/team</span
      >
    </div>
    <!-- host content: the invite form the agent is operating -->
    <div class="min-h-[210px] p-4">
      <p class="text-[0.8rem] font-bold text-ink">Invite teammate</p>
      <div class="mt-3 max-w-[300px] space-y-2.5">
        <div>
          <p class="text-[0.62rem] font-semibold uppercase tracking-wide text-gray-400">Email</p>
          <div
            data-anim="ag-email"
            class="mt-1 flex h-8 items-center rounded-control border border-gray-150 bg-white px-2.5 text-[0.72rem] font-medium text-ink"
          >
            alex@acme.com
          </div>
        </div>
        <div class="media-fill h-8 rounded-control"></div>
        <button
          data-anim="ag-send"
          tabindex="-1"
          class="rounded-control px-3 py-1.5 text-[0.7rem] font-bold text-white ring-2 ring-brand-400 ring-offset-2 transition-all duration-300"
          style="background: linear-gradient(180deg, #4a63e8, #3a50dd)">Send invite</button
        >
      </div>
    </div>
  </div>

  <!-- the run card -->
  <div
    class="absolute -bottom-10 -right-2 w-[264px] rounded-card border border-gray-100 bg-white p-4 shadow-widget sm:-right-5"
  >
    <div class="flex items-center justify-between gap-2">
      <p class="font-mono text-[0.58rem] font-bold uppercase tracking-widest text-brand-500">
        AI Agent
      </p>
      <span data-anim="ag-prog" class="font-mono text-[0.6rem] font-semibold text-gray-500">3/3</span>
    </div>
    <p class="mt-1.5 text-[0.8rem] font-bold text-ink">Invite a teammate</p>
    <div
      class="mt-2.5 flex items-start gap-2 rounded-tile border border-gray-100 bg-paper px-2.5 py-2 text-[0.72rem] leading-snug text-gray-700"
    >
      <svg
        data-anim="ag-done"
        class="mt-px shrink-0 text-success-dot"
        width="13"
        height="13"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="9.5"></circle>
        <path d="m8.5 12.5 2.4 2.4 4.8-5.2"></path>
      </svg>
      <span data-anim="ag-status">Done — outcome verified.</span>
    </div>
    <button
      data-anim="ag-run"
      tabindex="-1"
      class="mt-2.5 hidden w-full rounded-control px-3 py-2 text-[0.72rem] font-bold text-white shadow-primary"
      style="background: linear-gradient(180deg, #4a63e8, #3a50dd)">Run it for me</button
    >
    <button
      data-anim="ag-stop"
      tabindex="-1"
      class="mt-2.5 hidden w-full rounded-control border border-gray-150 bg-white px-3 py-2 text-[0.72rem] font-bold text-gray-600"
      >Stop Auto Run</button
    >
  </div>
</div>
