---
// Section 5 — the sign-up block. Copy is deliberately simple for now; the
// founder will decide its final content later.
import AiButton from './AiButton.astro';
---

<section>
  <div class="mx-auto max-w-[1140px] px-5 py-12 md:px-8 md:py-16">
    <div
      class="rounded-dialog px-7 py-12 text-center shadow-primary md:px-16"
      style="background: linear-gradient(160deg, #4a63e8, #3a50dd)"
    >
      <h2
        class="mx-auto max-w-2xl text-[clamp(1.5rem,3vw,2.2rem)] font-extrabold leading-tight tracking-tight text-white"
      >
        Give your users the help and support when they need it the most.
      </h2>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://app.flowbuddyai.com/signup"
          class="inline-flex items-center justify-center rounded-control bg-white px-7 py-3.5 text-[0.95rem] font-bold text-brand-600 shadow-card transition-transform hover:-translate-y-px"
          >Get started free</a
        >
        <AiButton id="cta" variant="light" />
      </div>
    </div>
  </div>
</section>
