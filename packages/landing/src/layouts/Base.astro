---
// Base layout: head (SEO/OG/JSON-LD), fonts, header/footer, and the live
// dogfood widget. The widget renders only when FLOWBUDDY_LANDING_WIDGET_KEY is
// set at build time (the workspace's PUBLIC embeddable key — safe in HTML), so
// the page never blocks on the FlowBuddy-on-FlowBuddy KB existing.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  /** Path for the canonical URL, e.g. "/" or "/future". */
  path: string;
  /** Extra JSON-LD objects to embed alongside Organization + SoftwareApplication. */
  jsonLd?: object[];
  /** Keep utility pages (404) out of search indexes. */
  noindex?: boolean;
}

const { title, description, path, jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;

const widgetKey = import.meta.env.FLOWBUDDY_LANDING_WIDGET_KEY;
const widgetSrc =
  import.meta.env.FLOWBUDDY_LANDING_WIDGET_SRC ??
  'https://widget.flowbuddyai.com/flowbuddy-copilot.js';
const widgetApi =
  import.meta.env.FLOWBUDDY_LANDING_API_URL ?? 'https://api.flowbuddyai.com';

const baseJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'FlowBuddy',
    url: 'https://flowbuddyai.com',
    logo: 'https://flowbuddyai.com/favicon.svg',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'FlowBuddy',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    url: 'https://flowbuddyai.com',
    description:
      'FlowBuddy is an application intelligence layer for SaaS products. Record a demo of your product once; FlowBuddy learns how it works and turns that into a founder-approved intelligence layer powering an in-app AI assistant, contextual guidance, interactive onboarding, and consented AI agent execution — live in about 30 minutes, no coding required.',
    featureList: [
      'In-App AI Assistant — answers user questions inside the product, from approved knowledge only',
      'Contextual Guidance — reads the page the user is on and highlights their next step in the product UI',
      'Interactive Onboarding — guides a user through a whole task, one step at a time, across pages',
      'AI Agent Execution (beta) — carries out approved workflows with the user’s explicit consent; off by default, narrated, outcome-verified',
    ],
    offers: {
      '@type': 'Offer',
      price: '0',
      priceCurrency: 'USD',
      description: 'Free during early access',
    },
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FlowBuddy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://flowbuddyai.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="FlowBuddy — the Application Intelligence Layer for your SaaS. Record once; power your users and AI agents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://flowbuddyai.com/og.png" />
    <meta name="twitter:image:alt" content="FlowBuddy — the Application Intelligence Layer for your SaaS. Record once; power your users and AI agents." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(baseJsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    {
      widgetKey && (
        <script
          is:inline
          src={widgetSrc}
          data-flowbuddy-api={widgetApi}
          data-flowbuddy-key={widgetKey}
        />
      )
    }
    <!-- "See it in action": opens the embedded copilot (clicks its launcher inside the
         open shadow root). Until the widget is embedded, falls back to the knowledge-base
         section so the button is never dead — navigating home first on pages (the
         capability pages) that don't carry the section. -->
    <script is:inline>
      document.addEventListener('click', (e) => {
        if (!(e.target instanceof Element)) return;
        if (!e.target.closest('[data-open-copilot]')) return;
        const launcher = document
          .getElementById('flowbuddy-copilot-root')
          ?.shadowRoot?.querySelector('.fb-launcher');
        if (launcher instanceof HTMLElement) launcher.click();
        else {
          const kb = document.getElementById('knowledge-base');
          if (kb) kb.scrollIntoView({ behavior: 'smooth' });
          else location.href = '/#knowledge-base';
        }
      });
    </script>
  </body>
</html>
